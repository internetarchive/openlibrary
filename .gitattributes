# Auto detect text files, store them with LF, and check them out with LF on every OS
# (Docker runs the scripts on Linux, so a Windows CRLF checkout breaks the containers)
* text=auto eol=lf

# Standard to msysgit
*.doc	diff=astextplain
*.docx	diff=astextplain
*.pdf	diff=astextplain
*.rtf	diff=astextplain

# MARC binary
*.mrc	binary -linguist-detectable

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Generated by scripts/i18n-messages; driver registered by scripts/make-integration-branch.sh
openlibrary/i18n/messages.pot merge=messages-pot

# Tests aren't run on the testing server; driver registered by scripts/make-integration-branch.sh
**/tests/** merge=test-files
**/__tests__/** merge=test-files
test_*.py merge=test-files
conftest.py merge=test-files
# ...except these, which the site or scripts load at runtime
openlibrary/templates/tests/** !merge
scripts/tests/test_copydocs.py !merge

.github/workflows/*.lock.yml linguist-generated=true merge=ours
