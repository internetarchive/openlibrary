{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["before 9am on the first day of the month"],
  "prConcurrentLimit": 10,
  "git-submodules": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Python dependencies (non-major)",
      "groupSlug": "python-non-major",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "JS dependencies (non-major)",
      "groupSlug": "js-non-major",
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@axe-core/playwright",
        "@eslint/js",
        "@playwright/test",
        "@vitest/browser-playwright",
        "axe-core",
        "bundlesize2",
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue",
        "globals",
        "jsdom",
        "oxfmt",
        "oxlint",
        "stylelint",
        "stylelint-declaration-strict-value",
        "vitest",
        "vitest-browser-lit",
        "vitest-browser-vue"
      ],
      "groupName": "JS lint & test deps",
      "groupSlug": "js-lint-test",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@custom-elements-manifest/analyzer",
        "@vitejs/plugin-vue",
        "concurrently",
        "postcss-lit",
        "svgo",
        "vite"
      ],
      "groupName": "JS build deps",
      "groupSlug": "js-build",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@ericblade/quagga2",
        "@sentry/browser",
        "@tiptap/**",
        "chart.js",
        "chartjs-plugin-*",
        "datatables.net-dt",
        "diff",
        "isbn3",
        "jquery",
        "jquery-ui",
        "jquery-ui-touch-punch",
        "lit",
        "lucene-query-parser",
        "prismjs",
        "slick-carousel",
        "tesseract.js",
        "tiptap-markdown",
        "vue",
        "vue-async-computed",
        "vue-multiselect",
        "workbox-*"
      ],
      "groupName": "JS runtime deps",
      "groupSlug": "js-runtime",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@internetarchive/**"
      ],
      "groupName": "Internet Archive JS deps",
      "groupSlug": "js-ia",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "vitest",
        "@vitest/browser-playwright",
        "vitest-browser-lit",
        "vitest-browser-vue",
        "bundlesize2",
        "stylelint",
        "stylelint-declaration-strict-value",
        "oxfmt",
        "oxlint"
      ],
      "automerge": false
    },
    {
      "automerge": false,
      "matchPackageNames": [
        "mypy",
        "pytest",
        "pytest-asyncio",
        "ruff"
      ]
    },
    {
      "automerge": false,
      "matchPackageNames": [
        "/^actions//"
      ]
    },
    {
      "matchCategories": ["security"],
      "groupName": null,
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "prConcurrentLimit": 0
    }
  ]
}
