{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "helpers:githubDigestChangelogs"
  ],
  "minimumReleaseAge": "7 days",
  "schedule": ["before 9am on the first day of the month"],
  "prConcurrentLimit": 10,
  "git-submodules": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "Catch-all for Python runtime deps (requirements.txt) not in a group below. Patch/minor only: majors keep their own PR. Must stay before the more specific Python rules (last match wins).",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "Python other runtime deps",
      "groupSlug": "python-other-runtime"
    },
    {
      "description": "Packages that tend to need matching bumps. Patch/minor only: majors keep their own PR.",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": [
        "fastapi",
        "gunicorn",
        "httpx",
        "multipart",
        "prometheus-fastapi-instrumentator",
        "pydantic",
        "pydantic-settings",
        "python-multipart",
        "sentry-sdk",
        "uvicorn"
      ],
      "groupName": "Python web stack",
      "groupSlug": "python-web"
    },
    {
      "description": "Offline-script deps. All update types, including majors.",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements_scripts.txt"],
      "groupName": "Python script deps",
      "groupSlug": "python-scripts"
    },
    {
      "description": "Dev-only deps. All update types, including majors. Matched by file so new test packages are picked up automatically.",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["requirements_test.txt"],
      "groupName": "Python test & lint deps",
      "groupSlug": "python-test-lint",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Bump the range in package.json on every npm update (not just the lockfile), so declared minimums match what we run.",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Catch-all for npm packages not yet in a category below. Must stay before the category rules (last match wins).",
      "matchManagers": ["npm"],
      "groupName": "JS other deps",
      "groupSlug": "js-other",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@axe-core/playwright",
        "@eslint/js",
        "@playwright/test",
        "@vitest/browser-playwright",
        "axe-core",
        "bundlesize2",
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue",
        "globals",
        "jsdom",
        "oxfmt",
        "oxlint",
        "stylelint",
        "stylelint-declaration-strict-value",
        "vitest",
        "vitest-browser-lit",
        "vitest-browser-vue"
      ],
      "groupName": "JS lint & test deps",
      "groupSlug": "js-lint-test",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@custom-elements-manifest/analyzer",
        "@vitejs/plugin-vue",
        "concurrently",
        "postcss-lit",
        "svgo",
        "vite"
      ],
      "groupName": "JS build deps",
      "groupSlug": "js-build",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@ericblade/quagga2",
        "@sentry/browser",
        "@tiptap/**",
        "chart.js",
        "chartjs-plugin-*",
        "datatables.net-dt",
        "diff",
        "isbn3",
        "jquery",
        "jquery-ui",
        "jquery-ui-touch-punch",
        "lit",
        "lucene-query-parser",
        "prismjs",
        "slick-carousel",
        "tesseract.js",
        "tiptap-markdown",
        "vue",
        "vue-async-computed",
        "vue-multiselect",
        "workbox-*"
      ],
      "groupName": "JS runtime deps",
      "groupSlug": "js-runtime",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@internetarchive/**"
      ],
      "groupName": "Internet Archive JS deps",
      "groupSlug": "js-ia",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-vue"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "vitest",
        "@vitest/browser-playwright",
        "vitest-browser-lit",
        "vitest-browser-vue",
        "bundlesize2",
        "stylelint",
        "stylelint-declaration-strict-value",
        "oxfmt",
        "oxlint"
      ],
      "automerge": false
    },
    {
      "automerge": false,
      "matchPackageNames": [
        "mypy",
        "pytest",
        "pytest-asyncio",
        "ruff"
      ]
    },
    {
      "automerge": false,
      "matchPackageNames": [
        "/^actions//"
      ]
    },
    {
      "matchCategories": ["security"],
      "groupName": null,
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "prConcurrentLimit": 0
    }
  ]
}
