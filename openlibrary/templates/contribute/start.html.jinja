{#- /contribute — orientation in sixty seconds, and the ways into the list. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="fe-page fe-page--start">
    <header class="fe-hero">
        <h1 class="fe-title">{{ _("Make your first edit") }}</h1>
        <p class="fe-lede">{{ _("Most people finish their first one in about five minutes.") }}</p>
    </header>
    {{ parts.tabs(data.tabs) }}
    <div class="fe-cards">
        <section class="fe-card">
            <span class="fe-card__icon">{{ icon("book-open-text", size="lg") }}</span>
            <h2 class="fe-card__title">{{ _("What you'll do") }}</h2>
            <p>{{ _("Pick a book. We show one fact that is missing or in doubt, next to what other library catalogs say. You fill it in, correct it, or say you're not sure.") }}</p>
        </section>
        <section class="fe-card">
            <span class="fe-card__icon">{{ icon("circle-user-round", size="lg") }}</span>
            <h2 class="fe-card__title">{{ _("How it's checked") }}</h2>
            <p>{{ _("Nothing changes on the book right away. A volunteer librarian reviews your suggestion against the same evidence, usually within %(days)s days, and accepts it, corrects it, or declines it with a note.", days=data.wait_days) }}</p>
        </section>
        <section class="fe-card">
            <span class="fe-card__icon">{{ icon("circle-help", size="lg") }}</span>
            <h2 class="fe-card__title">{{ _("When you're not sure") }}</h2>
            <p>{{ _("Say so. “I'm not sure” sends the question to a librarian instead of a guess, which is more useful than a wrong answer and never counts against you.") }}</p>
        </section>
    </div>
    <div class="fe-hero__actions">
        {% if data.allowed %}
            <ol-button variant="primary" href="/contribute/needed">
                {{ _("Show me a book that needs help") }}
            </ol-button>
            <ol-button href="/contribute/yours">
                {{ _("Start with books I've read") }}
            </ol-button>
        {% elif data.logged_in %}
            <p class="fe-callout">{{ _("First edits is being tried out with a small group. Ask in the volunteers channel to be added, and this page will open up.") }}</p>
        {% else %}
            <ol-button variant="primary" href="/account/login?redirect=/contribute">
                {{ _("Log in to start") }}
            </ol-button>
            <p class="fe-muted">{{ _("You need an Open Library account so your suggestions have a name on them.") }}</p>
        {% endif %}
    </div>
    <p class="fe-note fe-note--walkthrough">
        {{ icon("wand", size="sm") }}
        <span>{{ _("This is a walkthrough. Outside catalog data is from a saved sample, and nothing you send is stored yet.") }}</span>
    </p>
</div>
