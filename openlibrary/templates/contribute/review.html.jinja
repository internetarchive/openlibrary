{#- /contribute/review-preview — one row of what a reviewing librarian would see. Preview only. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="fe-page">
    <header class="fe-pagehead">
        <div>
            <p class="fe-overline">{{ _("First edits · preview") }}</p>
            <h1 class="fe-title">{{ _("What a librarian sees") }}</h1>
        </div>
        <a class="fe-pagehead__side" href="/contribute/start">{{ _("Back to start") }}</a>
    </header>
    <p class="fe-lede">{{ _("Every suggestion arrives with its evidence attached, so a review takes seconds. Reviewers work the sure things first and spend their judgment on the rest.") }}</p>
    <div class="fe-review">
        <div class="fe-review__bar">
            <strong>{{ _("Field suggestions · %(count)s open", count=data.open_count) }}</strong>
            <span class="fe-muted">{{ _("Median wait %(days)s days", days=data.median_days) }}</span>
        </div>
        <nav class="fe-tabs fe-tabs--small" aria-label="{{ _('Groups') }}">
            <span class="is-on">{{ _("Strong evidence") }}</span>
            <span>{{ _("Needs judgment") }}</span>
            <span>{{ _("Not sure") }}</span>
        </nav>
        {% if data.item %}
            <div class="fe-review__row">
                <div class="fe-review__head">
                    <strong>{{ data.item.title }}</strong> · {{ data.item.edition_line }} ·
                    <span class="fe-muted">{{ data.item.field_label }}:</span>
                    {% if data.item.old %}<s>{{ data.item.old }}</s> →{% endif %} <strong>{{ data.item.new }}</strong>
                    <span class="fe-muted">· {{ _("first edit") }} · {{ data.item.sent }}</span>
                </div>
                {% if data.evidence %}
                    <div class="fe-chips">
                        {% for row in data.evidence.rows %}
                            <span class="fe-chip fe-chip--static{% if row.agrees is false %} fe-chip--differs{% endif %}">{{ row.name }}: {{ row.display }}</span>
                        {% endfor %}
                    </div>
                    <p class="fe-muted">{{ data.evidence.sentence }}</p>
                {% endif %}
                <div class="fe-review__actions">
                    <ol-button variant="primary" disabled>
                        {{ _("Accept") }}
                    </ol-button>
                    <ol-button disabled>
                        {{ _("Accept with edit") }}
                    </ol-button>
                    <ol-button variant="ghost" disabled>
                        {{ _("Decline…") }}
                    </ol-button>
                    <span class="fe-muted">{{ _("Preview only. Accepting writes the field and tells the person who suggested it.") }}</span>
                </div>
            </div>
        {% endif %}
        <div class="fe-review__reasons">
            <span class="fe-h">{{ _("Decline reasons a reviewer can pick") }}</span>
            <ul>
                <li>{{ _("Imprint, not parent company") }}</li>
                <li>{{ _("That's a tagline or series name, not a subtitle") }}</li>
                <li>{{ _("ISBN reused across printings; needs the physical book") }}</li>
                <li>{{ _("Catalogs disagree; leaving as is") }}</li>
            </ul>
            <p class="fe-muted">{{ _("Each reason links to a guideline, so a decline reads as coaching rather than a rejection.") }}</p>
        </div>
    </div>
</div>
