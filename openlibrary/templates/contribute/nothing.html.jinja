{#- A task URL whose field is already filled in. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="contrib-page">
    {{ parts.book_header(data.book) }}
    <section class="contrib-section">
        <h1 class="contrib-question__text">{{ _("%(field)s is already filled in on this edition", field=data.field_label) }}</h1>
        <p>{{ _("Someone filled it in since the list was made. Thank you for checking.") }}</p>
        <ol-button href="{{ data.list_url }}">
            {{ _("Back to the list") }}
        </ol-button>
    </section>
</div>
