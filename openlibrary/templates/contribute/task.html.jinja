{#- /contribute/task/OL…M/<field> — one book, one missing field, answered in place on the record. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="fe-page fe-page--task" data-contribute-task>
    <a class="fe-back" href="{{ data.list_url }}">{{ icon("chevron-left", size="sm") }}{{ _("Back to the list") }}</a>
    <div class="fe-task__main">
        <div class="fe-question">
            <h1 class="fe-question__text">{{ data.playbook.question }}</h1>
            {% if data.playbook.why %}<p class="fe-muted">{{ data.playbook.why }}</p>{% endif %}
        </div>
        {{ parts.record_form(data) }}
    </div>
    <aside class="fe-task__help">
        {{ parts.how_to(data.playbook, data.link_outs) }}
        {% if data.playbook.traps %}{{ parts.traps(data.playbook.traps) }}{% endif %}
        {% if data.siblings %}
            {{ parts.sibling_tally(data.tally, data.siblings, data.sibling_total, data.playbook.sibling_hint) }}
        {% endif %}
    </aside>
</div>
