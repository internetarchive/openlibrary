{#- /contribute/needed and /contribute/yours — a list of books with something to check.
    Which books, and in what order, is decided in contribute.py; this page only shows them. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="fe-page" data-contribute-list>
    <header class="fe-hero">
        <h1 class="fe-title">{{ data.heading }}</h1>
        {% if data.lede %}<p class="fe-lede">{{ data.lede }}</p>{% endif %}
    </header>
    {{ parts.tabs(data.tabs) }}
    <ol class="fe-rows">
        {% for row in data.rows %}
            <li class="fe-row" data-book-row>
                {{ parts.book_header(row.book, compact=True) }}
                <ul class="fe-row__tasks">
                    {% for task in row.tasks %}
                        {{ parts.task_row(task) }}
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ol>
    <div class="fe-empty" data-list-empty {% if data.rows %}hidden{% endif %}>
        <p>{{ data.empty }}</p>
        {% if data.empty_link %}
            <ol-button href="{{ data.empty_link.url }}">
                {{ data.empty_link.label }}
            </ol-button>
        {% endif %}
    </div>
    <p class="fe-muted fe-list__note">
        <span>{{ data.sort_note }}</span>
        <span>{{ _("Skip any you're unsure about.") }}</span>
    </p>
</div>
