{#- /tasks/task/OL…M/<field>/done — the receipt, and what happens next. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="contrib-page" data-contribute-done>
    <section class="contrib-receipt">
        {% if data.cover_url %}
            <img class="contrib-receipt__cover"
                 src="{{ data.cover_url }}"
                 alt="{{ _('The cover you added') }}"
                 width="96"
                 height="144" />
        {% else %}
            <span class="contrib-receipt__icon">{{ icon("circle-check" if data.saved else "arrow-right", size="lg") }}</span>
        {% endif %}
        <div>
            <p class="contrib-overline">
                {% if data.saved %}
                    {{ _("Saved") }}
                {% elif data.not_found_label %}
                    {{ data.not_found_label }}
                {% else %}
                    {{ _("Skipped") }}
                {% endif %}
            </p>
            <h1 class="contrib-receipt__title">
                {% if data.saved and data.value %}
                    {{ _("%(field)s for %(title)s: %(value)s", field=data.field_label, title=data.book.title, value=data.value) }}
                {% else %}
                    {{ _("%(field)s for %(title)s", field=data.field_label, title=data.book.title) }}
                {% endif %}
            </h1>
            {% if data.saved %}
                <p>
                    {{ _("The record is updated.") }}
                    <a href="{{ data.history_url }}"
                       data-ol-link-track="TaskDone|ViewHistory">{{ _("See it in the record's history") }}</a>
                </p>
            {% elif data.not_found_label %}
                <p>{{ _("Nothing on the record changed. We noted your answer, and once enough people give it, this task leaves the list.") }}</p>
            {% else %}
                <p>{{ _("Nothing on the record changed.") }}</p>
            {% endif %}
        </div>
    </section>
    {% if data.same_book %}
        <section class="contrib-section contrib-next" data-same-book>
            <span class="contrib-h">{{ _("While you're on this book") }}</span>
            {{ parts.task_book(data.book, data.book_labels, tasks=data.same_book, compact=True, track="TaskDone|SameBookTask") }}
        </section>
    {% endif %}
    <div class="contrib-hero__actions">
        <ol-button variant="primary" href="{{ data.next_url }}" data-ol-link-track="TaskDone|NextTask|{{ 'saved' if data.saved else 'notfound' if data.not_found_label else 'skipped' }}">
            {{ _("Next task") }}
        </ol-button>
        <ol-button href="{{ data.list_url }}" data-ol-link-track="TaskDone|PickDifferent">
            {{ _("Pick a different book") }}
        </ol-button>
    </div>
</div>
