{#- /contribute/mine — your suggestions and where each one stands. Fixture states in phase 1. -#}
<div class="fe-page">
    <header class="fe-pagehead">
        <div>
            <p class="fe-overline">{{ _("First edits") }}</p>
            <h1 class="fe-title">{{ _("Your suggestions") }}</h1>
        </div>
        <a class="fe-pagehead__side" href="/contribute">{{ _("Find another book") }} {{ icon("arrow-right", size="sm") }}</a>
    </header>
    <p class="fe-lede">
        {{ _("%(pending)s waiting for review, %(accepted)s accepted, %(declined)s declined with a note. Volunteer librarians review suggestions in the order they arrive, usually within %(days)s days.", pending=data.counts.pending, accepted=data.counts.accepted, declined=data.counts.declined, days=data.wait_days) }}
    </p>
    <ol class="fe-timeline">
        {% for item in data.suggestions %}
            <li class="fe-timeline__item fe-timeline__item--{{ item.state }}">
                <span class="fe-timeline__dot"></span>
                <div class="fe-timeline__body">
                    <div class="fe-timeline__head">
                        <strong>
                            {% if item.old %}
                                {{ _("%(field)s for %(title)s: %(old)s → %(new)s", field=item.field_label, title=item.title, old=item.old, new=item.new) }}
                            {% else %}
                                {{ _("%(field)s for %(title)s: %(new)s", field=item.field_label, title=item.title, new=item.new) }}
                            {% endif %}
                        </strong>
                        {% if item.state == "accepted" %}
                            <span class="fe-pill fe-pill--confirm">{{ _("Accepted") }}</span>
                        {% elif item.state == "pending" %}
                            <span class="fe-pill fe-pill--check">{{ _("Waiting for review") }}</span>
                        {% else %}
                            <span class="fe-pill fe-pill--declined">{{ _("Declined, with a note") }}</span>
                        {% endif %}
                    </div>
                    <div class="fe-muted">{{ item.edition_line }}</div>
                    {% if item.state == "accepted" %}
                        <p class="fe-muted">{{ _("Reviewed by librarian %(reviewer)s %(when)s. It's live on the book page and seen by about %(readers)s readers a year.", reviewer=item.reviewer, when=item.reviewed, readers="{:,}".format(item.readers)) }} <a href="{{ item.book_key }}">{{ _("See the book") }}</a></p>
                    {% elif item.state == "pending" %}
                        <p class="fe-muted">{{ _("Sent %(when)s. %(ahead)s suggestions ahead of yours. Usual wait %(days)s days.", when=item.sent, ahead=item.queue_ahead, days=data.wait_days) }} <a href="#">{{ _("Withdraw") }}</a></p>
                    {% else %}
                        <blockquote class="fe-decline">
                            <p>“{{ item.note }}”</p>
                            <footer>
                                {{ _("librarian %(reviewer)s", reviewer=item.reviewer) }} · <a href="{{ item.guideline }}" target="_blank" rel="noopener noreferrer">{{ _("The guideline") }}</a>
                            </footer>
                        </blockquote>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>
    <p class="fe-note fe-note--walkthrough">
        {{ icon("wand", size="sm") }}
        <span>{{ _("This is a walkthrough. These three are sample suggestions so you can see how each outcome looks. Nothing you send is stored yet.") }}</span>
    </p>
</div>
