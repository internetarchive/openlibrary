{#- /contribute — the librarian dashboard: one task at random, or a list narrowed by the rail.
    Which books, and in what order, is decided in contribute.py; this page only shows them. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="contrib-dash" data-contribute-list>
    <header class="contrib-dash__head">
        <div class="contrib-hero">
            <p class="contrib-overline">{{ _("Librarian dashboard") }}</p>
            <h1 class="contrib-title">{{ _("Contribute") }}</h1>
        </div>
        <div class="contrib-dash__one">
            <ol-button variant="primary" href="{{ data.one_task_url }}">
                {{ icon("dices", slot="icon-start") }}
                {{ _("Surprise me") }}
            </ol-button>
            <span class="contrib-muted">{{ _("A random book that needs a hand.") }}</span>
        </div>
    </header>
    <section class="contrib-intro" data-intro aria-label="{{ _('How it works') }}">
        <ol class="contrib-intro__steps">
            <li class="contrib-intro__step">
                <strong>{{ _("Pick a book") }}</strong>
                <span class="contrib-muted">{{ _("Or let us pick. Each task is one missing detail.") }}</span>
            </li>
            <li class="contrib-intro__step">
                <strong>{{ _("Look it up") }}</strong>
                <span class="contrib-muted">{{ _("We link to catalogs that have it and show how other editions fill it in.") }}</span>
            </li>
            <li class="contrib-intro__step">
                <strong>{{ _("Save it") }}</strong>
                <span class="contrib-muted">{{ _("The record updates right away, and the edit shows in its history.") }}</span>
            </li>
        </ol>
        <button type="button"
                class="contrib-intro__close"
                data-intro-close
                aria-label="{{ _('Hide this introduction') }}">{{ icon("x", size="sm") }}</button>
    </section>
    <div class="contrib-dash__body">
        <nav class="contrib-rail" aria-label="{{ _('Filter tasks') }}">
            <div class="contrib-rail__group">
                <a class="contrib-rail__item{{ ' is-on' if data.rail.all.on else '' }}"
                   href="{{ data.rail.all.url }}"
                   {% if data.rail.all.on %}aria-current="page"{% endif %}>{{ data.rail.all.label }}</a>
            </div>
            <div class="contrib-rail__group">
                <span class="contrib-overline">{{ _("Missing") }}</span>
                {% for item in data.rail.filters %}
                    <a class="contrib-rail__item{{ ' is-on' if item.on else '' }}"
                       href="{{ item.url }}"
                       {% if item.on %}aria-current="true"{% endif %}>{{ item.label }}</a>
                {% endfor %}
            </div>
        </nav>
        <main class="contrib-dash__main">
            <div class="contrib-dash__listhead">
                <h2 class="contrib-dash__h2">{{ data.heading }}</h2>
                <span class="contrib-muted">{{ data.sort_note }}</span>
            </div>
            <ol class="contrib-rows">
                {% for row in data.rows %}
                    <li class="contrib-row" data-book-row>
                        {{ parts.book_header(row.book, compact=True) }}
                        <ul class="contrib-row__tasks">
                            {% for task in row.tasks %}
                                {{ parts.task_row(task) }}
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ol>
            <div class="contrib-empty"
                 data-list-empty
                 {% if data.rows %}hidden{% endif %}>
                <p>{{ data.empty }}</p>
            </div>
        </main>
        <aside class="contrib-dash__aside">
            <section class="contrib-side">
                <h2 class="contrib-dash__h2">{{ _("Your recent fixes") }}</h2>
                {% if data.recent %}
                    <ul class="contrib-recent">
                        {% for fix in data.recent %}
                            <li class="contrib-recent__item">
                                <a href="{{ fix.url }}">{{ fix.title }}</a>
                                <span class="contrib-muted">{{ fix.field_label }}{% if fix.value %}: {{ fix.value }}{% endif %}</span>
                                <span class="contrib-muted contrib-recent__when">{{ fix.when }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="contrib-muted">{{ _("Fixes you save here show up in this list.") }}</p>
                {% endif %}
            </section>
        </aside>
    </div>
</div>
