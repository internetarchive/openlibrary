{#- /tasks — Open Library Tasks: one task at random, or a list narrowed by the rail.
    Which books, and in what order, is decided in contribute.py; this page only shows them. -#}
{% import "contribute/parts.html.jinja" as parts %}
<div class="contrib-dash" data-contribute-list>
    <header class="contrib-dash__head">
        <div class="contrib-hero">
            <h1 class="contrib-title">{{ _("Tasks") }}</h1>
            <p class="contrib-muted">{{ _("Fill in what's missing on real books, one detail at a time.") }}</p>
        </div>
        <div class="contrib-dash__one">
            <ol-button variant="primary" full-width href="{{ data.one_task_url }}" data-ol-link-track="TasksDashboard|SurpriseMe">
                {{ icon("dices", slot="icon-start") }}
                {{ _("Surprise me") }}
            </ol-button>
            <span class="contrib-muted">{{ _("A random book that needs a hand.") }}</span>
        </div>
    </header>
    <div class="contrib-dash__body">
        <nav class="contrib-rail" data-rail aria-label="{{ _('Filter tasks') }}">
            <div class="contrib-rail__group">
                <a class="contrib-rail__item{{ ' is-on' if data.rail.all.on else '' }}"
                   href="{{ data.rail.all.url }}"
                   data-ol-link-track="TasksDashboard|Filter|{{ data.rail.all.track }}"
                   {% if data.rail.all.on %}aria-current="page"{% endif %}>{{ data.rail.all.label }}</a>
            </div>
            <div class="contrib-rail__group">
                <span class="contrib-overline">{{ _("Missing") }}</span>
                {% for item in data.rail.filters %}
                    <a class="contrib-rail__item{{ ' is-on' if item.on else '' }}"
                       href="{{ item.url }}"
                       data-ol-link-track="TasksDashboard|Filter|{{ item.track }}"
                       {% if item.on %}aria-current="true"{% endif %}>{{ item.label }}</a>
                {% endfor %}
            </div>
        </nav>
        <main class="contrib-dash__main">
            <h2 class="contrib-dash__h2 contrib-dash__listhead">{{ data.heading }}</h2>
            {#- While a cold cache builds the list in the background, placeholders stand in and contribute.js fetches the rows from data-rows-url. -#}
            <ol class="contrib-rows"
                data-rows
                {% if data.rows_url %}data-rows-url="{{ data.rows_url }}"{% endif %}>
                {% if data.rows_url %}
                    {% for _i in range(data.skeleton_rows or 0) %}
                        {{ parts.row_skeleton(tasks=2 + loop.index % 2) }}
                    {% endfor %}
                {% else %}
                    {% with rows = data.rows %}
                        {% include "contribute/rows.html.jinja" %}
                    {% endwith %}
                {% endif %}
            </ol>
            <div class="contrib-empty"
                 data-list-empty
                 {% if data.rows or data.rows_url %}hidden{% endif %}>
                <p>{{ data.empty }}</p>
            </div>
            {% if data.rows_url %}
                <div class="contrib-empty" data-list-error hidden>
                    <p>{{ _("Tasks couldn't load right now. Reload the page to try again.") }}</p>
                </div>
            {% endif %}
        </main>
        <aside class="contrib-dash__aside">
            {% if data.progress %}
                <section class="contrib-side contrib-progress">
                    <span class="contrib-overline">{{ _("Current initiative") }}</span>
                    <h2 class="contrib-dash__h2">{{ data.progress.title }}</h2>
                    <p class="contrib-progress__figure">
                        <span class="contrib-progress__percent">{{ data.progress.figure }}</span>
                        {{ data.progress.summary }}
                    </p>
                    <meter class="contrib-progress__meter"
                           min="0"
                           max="100"
                           value="{{ data.progress.percent }}">
                        {{ data.progress.figure }}
                    </meter>
                    <p class="contrib-muted">{{ data.progress.books }}</p>
                </section>
            {% endif %}
            <section class="contrib-side">
                <h2 class="contrib-dash__h2">{{ _("Your recent fixes") }}</h2>
                {% if data.recent %}
                    <ul class="contrib-recent">
                        {% for fix in data.recent %}
                            <li class="contrib-recent__item">
                                <a class="contrib-recent__title"
                                   href="{{ fix.url }}"
                                   data-ol-link-track="TasksDashboard|RecentEdit">{{ fix.title }}</a>
                                <span class="contrib-muted contrib-recent__meta">{{ fix.when }}{% if fix.field_label %} · {{ fix.field_label }}{% endif %}</span>
                            </li>
                        {% endfor %}
                    </ul>
                    <a class="contrib-recent__all"
                       href="{{ data.history_url }}"
                       data-ol-link-track="TasksDashboard|SeeAllEdits">{{ _("See all your edits") }}</a>
                {% else %}
                    <p class="contrib-muted">{{ _("Fixes you save here show up in this list.") }}</p>
                {% endif %}
            </section>
            {% if data.apply %}
                <section class="contrib-side">
                    <h2 class="contrib-dash__h2">{{ _("Go further") }}</h2>
                    <p class="contrib-muted">{{ data.apply.note }}</p>
                    <ol-button variant="secondary" href="{{ data.apply.href }}" target="_blank" rel="noopener">
                        {{ data.apply.label }}
                    </ol-button>
                </section>
            {% endif %}
        </aside>
    </div>
</div>
