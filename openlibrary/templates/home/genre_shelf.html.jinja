{#
  The shelf that opens under a "Browse the stacks" tile. Rendered by HomeGenrePartial;
  `carousel` is a lazy placeholder for the genre's row, whose subgenre control narrows it in place
  (lazy-carousel.js). The row carries the heading; the tile that opened it names the shelf.
#}
{% if genre is defined %}
    <div class="genre-shelf"
         data-genre="{{ genre.slug }}"
         role="region"
         aria-label="{{ genre.name }}"
         tabindex="-1">{{ carousel | safe }}</div>
{% endif %}
