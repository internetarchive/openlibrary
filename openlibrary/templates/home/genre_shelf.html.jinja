{#
  The shelf that opens under a "Browse the stacks" tile. Rendered by HomeGenrePartial. A header
  names the genre, links to each subgenre's row ("Jump to") and carries the shelf's sort control.
  Then `carousel`, the genre's row, already loaded, and `subgenre_rows`, lazy placeholders for one
  row per subgenre, stacked beneath it. The genre row's wrapper carries its config, as a lazy-loaded
  row's does. The sort control re-sorts every row (lazy-carousel.js); `sort` is the shelf's current one.
  The skeleton in home/browse_stacks.html.jinja mirrors this shape.
#}
{% if genre is defined %}
    <div class="genre-shelf"
         data-genre="{{ genre.slug }}"
         data-sort="{{ sort }}"
         role="region"
         aria-label="{{ name }}"
         tabindex="-1">
        <div class="genre-shelf__header">
            <div class="genre-shelf__heading">
                <h2 class="genre-shelf__title">{{ name }}</h2>
                {% if jump_links %}
                    <nav class="genre-shelf__jump"
                         aria-label="{{ _('%(genre)s subgenres', genre=name) }}">
                        <span class="genre-shelf__jump-label">{{ _("Jump to") }}</span>
                        {% for link in jump_links %}
                            <a class="genre-shelf__jump-link" href="{{ link.href }}">{{ link.name }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}
            </div>
            {# The component supplies the trigger, so its label follows the choice without a re-render. #}
            {% set sort_items = [
                {"value": "trending", "label": _("Trending")},
                {"value": "new", "label": _("Newest")},
                {"value": "rating", "label": _("Top rated")},
            ] %}
            <ol-menu-popover class="genre-shelf__sort" label="{{ _('Sort by') }}" heading="{{ _('Sort by') }}" value="{{ sort }}" items="{{ sort_items | tojson | forceescape }}">
            </ol-menu-popover>
        </div>
        <div class="lazy-carousel-loaded" data-config="{{ config_json }}">{{ carousel | safe }}</div>
        {% for row in subgenre_rows %}
            {{ row | safe }}
        {% endfor %}
    </div>
{% endif %}
