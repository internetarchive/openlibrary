{#
  The shelf that opens under a "Browse the stacks" tile. Rendered by HomeGenrePartial;
  `carousels` are lazy placeholders (the genre, then one per subgenre) that browse-stacks.js
  hands to lazy-carousel.js. The rows carry the headings; the tile that opened it names the shelf.
#}
{% if genre is defined %}
    <div class="genre-shelf"
         data-genre="{{ genre.slug }}"
         role="region"
         aria-label="{{ genre.name }}"
         tabindex="-1">
        {% for carousel in carousels %}
            {{ carousel | safe }}
        {% endfor %}
    </div>
{% endif %}
