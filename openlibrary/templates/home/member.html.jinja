{#
  One half of the top of the home page for a signed-in reader, a section about now: `reading` is a card
  holding the book they have in hand and a line for each other book in progress, `want` the covers of their
  Want to Read books that have a copy free. Each is fetched on its own by home-member.js (HomeMemberPartial)
  and put in its place in home/member_skeleton.html.jinja. Each carries the section's heading, which the
  first to arrive supplies. A half with nothing to show renders nothing.
  A Currently Reading book gets a Read or Borrow button only when a copy is free, and a caret button that
  opens the shelf menu, the way to mark it finished or take it off the list. On a line that button shows on
  hover or focus (always on touch); home-member.js marks a book that has left the shelf.
  `member` is home_member.build_part(): `member.agenda` is their loans, holds and Currently Reading books
  as one list, the book in hand first; `member.want` is the free Want to Read books, or when
  availability can't be read (`member.want_checked` is false) the shelf's borrowable books, free or not.
#}
{% set member = member | default(none) %}
{% set agenda = (member.agenda | default([])) if member else [] %}
{% set want = (member.want | default([])) if member else [] %}
{# `tip=false` drops the cover's hover card where the title and author are already written beside it. #}
{% macro cover(item, cls="", size="", tip=true, fit=false) %}
    <ol-book-cover class="{{ cls }}" {% if size %}size="{{ size }}"{% endif %} {% if fit %}fit{% endif %} {% if not tip %}no-tip{% endif %} src="{{ item.cover_url }}" book-title="{{ item.title }}" authors="{{ item.author }}" href="{{ item.url }}">
    </ol-book-cover>
{% endmacro %}
{% macro action(item, variant="secondary", size="small") %}
    {% if item.action.form %}
        <form class="home-now__action"
              method="post"
              action="{{ item.action.form.action }}">
            <input type="hidden" name="action" value="{{ item.action.form.value }}">
            <ol-button type="submit" variant="{{ variant }}" size="{{ size }}" full-width data-ol-link-track="HomeMember|{{ item.kind }}">
                {{ item.action.label }}
            </ol-button>
        </form>
    {% else %}
        <div class="home-now__action">
            <ol-button variant="{{ variant }}" size="{{ size }}" full-width href="{{ item.action.href }}" data-ol-link-track="HomeMember|{{ item.kind }}">
                {{ item.action.label }}
            </ol-button>
        </div>
    {% endif %}
{% endmacro %}
{% macro status(item) %}
    <p class="home-status home-status--{{ item.tone }}">
        {% if item.tone == "ready" %}
            {{ icon("circle-check-filled", size="sm") }}
        {% elif item.tone == "urgent" %}
            {{ icon("clock", size="sm") }}
        {% endif %}
        {{ item.status }}
    </p>
{% endmacro %}
{# A loan or hold has its own button; a Currently Reading book gets Read or Borrow when a copy is free, else none. #}
{% macro read_button(item, variant="secondary") %}
    {% if item.action %}
        {{ action(item, variant) }}
    {% elif item.cta is defined and item.cta %}
        <div class="home-now__cta">{{ item.cta }}</div>
    {% endif %}
{% endmacro %}
{# The caret button that opens the shelf menu: the way to mark a book finished, stopped or off the list. #}
{% macro shelf_menu(item) %}
    {% if item.shelf is defined and item.shelf %}
        <div class="home-now__shelf">{{ item.shelf }}</div>
    {% endif %}
{% endmacro %}
{% if agenda or want %}
    {% set first = agenda[0] if agenda else none %}
    <div class="home-now__head">
        <h2 class="home-now__title" id="home-now-title">
            {% if member.name %}
                {{ _("Welcome back, %(name)s", name=member.name) }}
            {% else %}
                {{ _("Welcome back") }}
            {% endif %}
        </h2>
    </div>
    {% if first %}
        {# One card for everything in progress: the book in hand, then a line for each of the others. #}
        <div class="home-now__reading"
             data-moved-labels="{{ {'1': _('Moved to Want to Read') , '3': _('Moved to Already Read'), '4': _('Moved to Stopped Reading'), 'none': _('Removed from your shelves')} | tojson | forceescape }}">
            <div class="home-now__label-row">
                <h3 class="home-now__label">
                    {{ icon("book-open", size="sm", extra_class="home-now__label-icon") }}
                    {{ _("Currently reading") }}
                </h3>
            </div>
            <article class="home-now__main"
                     data-work-key="{{ first.work_key | default('') }}">
                {{ cover(first, "home-now__cover", tip=false, fit=true) }}
                <div class="home-now__text">
                    <h4 class="home-now__book">
                        <a href="{{ first.url }}">{{ first.title }}</a>
                    </h4>
                    <p class="home-now__author">{{ first.author }}</p>
                    {% if first.note is defined %}<p class="home-now__note">{{ first.note }}</p>{% endif %}
                    <p class="home-now__moved" role="status"></p>
                    {% if first.status %}{{ status(first) }}{% endif %}
                </div>
                {# At the card's right edge, over the lines' buttons; the shelf menu shows under it. #}
                <div class="home-now__main-action">
                    {{ read_button(first, "primary") }}
                    {{ shelf_menu(first) }}
                </div>
            </article>
            {% if agenda[1:] %}
                <ul class="home-now__rest">
                    {% for item in agenda[1:member.side + 1] %}
                        <li class="home-now__item"
                            data-work-key="{{ item.work_key | default('') }}">
                            <ol-book-cover class="home-now__thumb" size="small" no-tip src="{{ item.thumb_url }}" book-title="{{ item.title }}" authors="{{ item.author }}" href="{{ item.url }}">
                            </ol-book-cover>
                            <div class="home-now__item-body">
                                <div class="home-now__item-text">
                                    <a class="home-now__item-title" href="{{ item.url }}">{{ item.title }}</a>
                                    {% if item.author %}<span class="home-now__item-author">{{ item.author }}</span>{% endif %}
                                </div>
                                <p class="home-now__moved" role="status"></p>
                                {% if item.status %}{{ status(item) }}{% endif %}
                                <div class="home-now__item-actions">
                                    {{ shelf_menu(item) }}
                                    {{ read_button(item) }}
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {# The card leads with loans and holds when the reader has any; otherwise it is only their shelf. #}
            <p class="home-now__more">
                {% if agenda | rejectattr("kind", "equalto", "reading") | list %}
                    <a class="carousel-see-all"
                       href="/account/loans"
                       data-ol-link-track="HomeMember|Loans">{{ _("See all loans and holds") }}{{ icon("chevron-right", size="sm") }}</a>
                {% else %}
                    <a class="carousel-see-all"
                       href="/account/books/currently-reading"
                       data-ol-link-track="HomeMember|CurrentlyReading">{{ _("See all currently reading") }}{{ icon("chevron-right", size="sm") }}</a>
                {% endif %}
            </p>
        </div>
    {% endif %}
    {% if want %}
        <div class="home-now__want">
            <div class="home-now__label-row">
                <h3 class="home-now__label">
                    {{ icon("bookmark", size="sm", extra_class="home-now__label-icon") }}
                    {{ _("Want to Read, available now") if member.want_checked else _("Want to Read") }}
                </h3>
                <a class="carousel-see-all"
                   href="/account/books/want-to-read"
                   aria-label="{{ _('See all %(title)s', title=_('Want to Read')) }}"
                   data-ol-link-track="HomeMember|WantToRead">{{ _("See all") }}{{ icon("chevron-right", size="sm") }}</a>
            </div>
            <ul class="home-now__wall">
                {% for item in want %}<li>{{ cover(item, "", "small") }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}
{% endif %}
