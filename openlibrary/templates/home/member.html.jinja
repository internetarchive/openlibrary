{#
  The top of the home page for a signed-in reader, as one section about now: the book they have in hand as a
  small card with what else is in progress listed under it, and beside it the covers of their Want to Read
  books that have a copy free.
  `member` is home_member.build_member(): `member.agenda` is their loans, holds and Currently Reading books
  as one list, the book in hand first; `member.want` is the free Want to Read books.
  Fetched after load by home-member.js (HomeMemberPartial).
#}
{% set member = member | default(none) %}
{% set agenda = member.agenda if member else [] %}
{% set want = member.want if member else [] %}
{% macro cover(item, cls="", size="") %}
    <ol-book-cover class="{{ cls }}" {% if size %}size="{{ size }}"{% endif %} src="{{ item.cover_url }}" book-title="{{ item.title }}" authors="{{ item.author }}" href="{{ item.url }}">
    </ol-book-cover>
{% endmacro %}
{% macro action(item, variant="secondary", size="medium") %}
    {% if item.action.form %}
        <form class="home-now__action"
              method="post"
              action="{{ item.action.form.action }}">
            <input type="hidden" name="action" value="{{ item.action.form.value }}">
            <ol-button type="submit" variant="{{ variant }}" size="{{ size }}" data-ol-link-track="HomeMember|{{ item.kind }}">
                {{ item.action.label }}
            </ol-button>
        </form>
    {% else %}
        <ol-button variant="{{ variant }}" size="{{ size }}" href="{{ item.action.href }}" data-ol-link-track="HomeMember|{{ item.kind }}">
            {{ item.action.label }}
        </ol-button>
    {% endif %}
{% endmacro %}
{% macro status(item) %}
    <p class="home-status home-status--{{ item.tone }}">
        {% if item.tone == "ready" %}
            {{ icon("circle-check-filled", size="sm") }}
        {% elif item.tone == "urgent" %}
            {{ icon("clock", size="sm") }}
        {% endif %}
        {{ item.status }}
    </p>
{% endmacro %}
{% if agenda or want %}
    {% set first = agenda[0] if agenda else none %}
    <section class="home-now{{ ' home-now--no-reading' if not agenda else '' }}{{ ' home-now--no-want' if not want else '' }}"
             aria-labelledby="home-now-title">
        <div class="home-now__head">
            <h2 class="home-now__title" id="home-now-title">
                {% if agenda %}
                    {{ _("Pick up where you left off") }}
                {% else %}
                    {{ _("Ready to read from your list") }}
                {% endif %}
            </h2>
            <div class="home-now__links">
                {% if agenda %}
                    <a class="carousel-see-all"
                       href="/account/loans"
                       data-ol-link-track="HomeMember|Loans">{{ _("Loans and holds") }}{{ icon("chevron-right", size="sm") }}</a>
                {% endif %}
                {% if want %}
                    <a class="carousel-see-all"
                       href="/account/books/want-to-read"
                       data-ol-link-track="HomeMember|WantToRead">{{ _("Want to Read") }}{{ icon("chevron-right", size="sm") }}</a>
                {% endif %}
            </div>
        </div>
        <div class="home-now__body">
            {% if first %}
                <div class="home-now__reading">
                    <article class="home-now__main">
                        {{ cover(first, "home-now__cover") }}
                        <div class="home-now__text">
                            {{ status(first) }}
                            <h3 class="home-now__book">
                                <a href="{{ first.url }}">{{ first.title }}</a>
                            </h3>
                            <p class="home-now__author">{{ first.author }}</p>
                            {% if first.note is defined %}<p class="home-now__note">{{ first.note }}</p>{% endif %}
                            <div class="home-now__main-action">{{ action(first, "primary", "medium") }}</div>
                        </div>
                    </article>
                    {% if agenda[1:] %}
                        <ul class="home-now__rest">
                            {% for item in agenda[1:member.side + 1] %}
                                <li class="home-now__item">
                                    {{ cover(item, "home-now__thumb", "small") }}
                                    <a class="home-now__item-title" href="{{ item.url }}">{{ item.title }}</a>
                                    {{ status(item) }}
                                    {% if item.kind in ("ready", "loan") %}{{ action(item, "secondary", "small") }}{% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            {% endif %}
            {% if want %}
                <div class="home-now__want">
                    <h3 class="home-now__label">
                        {{ icon("bookmark", size="sm", extra_class="home-now__label-icon") }}
                        {{ _("Free now from your Want to Read list") }}
                    </h3>
                    <ul class="home-now__wall">
                        {% for item in want %}<li>{{ cover(item, "", "small") }}</li>{% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </section>
{% endif %}
