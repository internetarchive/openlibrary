{#- A radio group of rows, each a title with what it means underneath. Styled by static/css/components/choice-list.css.
    name: the field; rows: [{value, label, description}]; value: the checked row's value; labelled_by: the id of the group's label.
    Rendered from Jinja ({% include %} inside a {% with %}) and from Templetor (render_jinja_template). -#}
{% if name is defined and rows is defined %}
    <div class="ol-choice-list"
         role="radiogroup"
         {% if labelled_by is defined and labelled_by %}aria-labelledby="{{ labelled_by }}"{% endif %}>
        {% for row in rows %}
            <label class="ol-choice">
                <input class="ol-choice__input"
                       type="radio"
                       name="{{ name }}"
                       value="{{ row.value }}"
                       {% if value is defined and row.value == value %}checked{% endif %} />
                <span class="ol-choice__text">
                    <span class="ol-choice__title">{{ row.label }}</span>
                    {% if row.description %}<span class="ol-choice__meta">{{ row.description }}</span>{% endif %}
                </span>
            </label>
        {% endfor %}
    </div>
{% endif %}
