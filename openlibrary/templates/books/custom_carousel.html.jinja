{#
  Shows one book carousel. `count` and `shelf` are optional: see carousel_count.html.jinja.
#}
{% from "books/carousel_count.html.jinja" import carousel_count %}
{% macro book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count=none, shelf=none, tools_html="") %}
    {# A carousel with header tools keeps its header when a sort or filter empties it,
       so the patron can change the controls back. #}
    {% if show or tools_html %}
        <div class="carousel-section">
            {% if title and url %}
                <div class="carousel-section-header {% if tools_html %}carousel-section-header--tools{% endif %}">
                    <h2 class="home-h2">
                        <a data-ol-link-track="BookCarousel|HeaderClick|{{ key }}"
                           href="{{ url }}">{{ title }}{{ carousel_count(count, shelf) }}</a>
                    </h2>
                    {{ tools_html | safe }}
                </div>
            {% endif %}
            {% if show %}
                <div class="carousel-container carousel-container-decorated">
                    <div class="carousel {{ grid }} {{ compact }} {{ loadjs }}"
                         data-config="{{ config_json }}">
                        {% for card in cards %}
                            {{ card | safe }}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <p class="carousel-empty">{{ _("No books match these filters.") }}</p>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}
{% if show is defined %}
    {{ book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count, shelf) }}
{% endif %}
