{# One book carousel: optional linked heading, then the cards.
   Data comes from get_book_carousel_data() in openlibrary/plugins/openlibrary/partials.py,
   which decides whether to render at all (`show`), builds the data-config JSON that
   carousel.js reads, and resolves each book's edition, author and loan shape. #}
{% if show %}
    <div class="carousel-section">
        {% if title and url %}
            <div class="carousel-section-header">
                <h2 class="home-h2">
                    <a data-ol-link-track="BookCarousel|HeaderClick|{{ key }}"
                       href="{{ url }}">{{ title }}</a>
                </h2>
            </div>
        {% endif %}
        <div class="carousel-container carousel-container-decorated">
            <div class="carousel {{ grid }} {{ compact }} {{ loadjs }}"
                 data-config="{{ config_json }}">
                {% for card in cards %}
                    {{ card | safe }}
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
