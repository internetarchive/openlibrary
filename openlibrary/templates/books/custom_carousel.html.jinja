{#
  Shows one book carousel. `count` and `shelf` are optional: see carousel_count.html.jinja.
#}
{% from "books/carousel_count.html.jinja" import carousel_count %}
{% macro book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count=none, shelf=none, see_all=false, layout="carousel") %}
    {% if show %}
        <div class="carousel-section">
            {% if title %}
                {# With a "See all" the header is one line: title, then the link at the end.
                   `see_all` moves the row's link off the title to that link. #}
                <div class="carousel-section-header{% if see_all %} carousel-section-header--inline{% endif %}">
                    <h2 class="home-h2">
                        {% if url and not see_all %}
                            <a data-ol-link-track="BookCarousel|HeaderClick|{{ key }}"
                               href="{{ url }}">{{ title }}{{ carousel_count(count, shelf) }}</a>
                        {% else %}
                            {{ title }}{{ carousel_count(count, shelf) }}
                        {% endif %}
                    </h2>
                    {% if see_all and url %}
                        <a class="carousel-see-all"
                           data-ol-link-track="BookCarousel|HeaderClick|{{ key }}"
                           href="{{ url }}"
                           aria-label="{{ _('See all %(title)s', title=title) }}">{{ _("See all") }}{{ icon("chevron-right", size="sm") }}</a>
                    {% endif %}
                </div>
            {% endif %}
            {% if layout == "ol-carousel" %}
                {# The native carousel component sizes the cards itself: two to a page on a phone, seven at
                   full width, 12px apart. CarouselSkeleton's columns mirror these breakpoints (carousel.css);
                   carousel/native.js adds load-more and analytics from the same data-config the slick rows use. #}
                <div class="carousel-container carousel-container-decorated">
                    <ol-carousel class="carousel--native" breakpoints="[[480, 2], [600, 3], [768, 4], [1024, 6], [null, 7]]" gap="12" label="{{ title }}" label-previous="{{ _('Previous page') }}" label-next="{{ _('Next page') }}" label-pages="{{ _('Carousel pages') }}" label-go-to-page="{{ _('Go to page {page} of {total}') }}" label-page-announcement="{{ _('Page {page} of {total}') }}" data-config="{{ config_json }}">
                        {% for card in cards %}
                            {{ card | safe }}
                        {% endfor %}
                    </ol-carousel>
                </div>
            {% else %}
                <div class="carousel-container carousel-container-decorated">
                    <div class="carousel {{ grid }} {{ compact }} {{ loadjs }}"
                         data-config="{{ config_json }}">
                        {% for card in cards %}
                            {{ card | safe }}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}
{% if show is defined %}
    {{ book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count, shelf, layout=layout | default('carousel')) }}
{% endif %}
