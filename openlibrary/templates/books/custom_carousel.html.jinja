{# Shows one book carousel. A shelf carousel's count is its own element so book-state.js can keep it current. #}
{% macro book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count=none, shelf=none) %}
    {% if show %}
        <div class="carousel-section">
            {% if title and url %}
                <div class="carousel-section-header">
                    <h2 class="home-h2">
                        <a data-ol-link-track="BookCarousel|HeaderClick|{{ key }}"
                           href="{{ url }}">{{ title }}{% if count is not none %} ({% if shelf %}<span data-shelf-count="{{ shelf }}">{{ count }}</span>{% else %}{{ count }}{% endif %}){% endif %}</a>
                    </h2>
                </div>
            {% endif %}
            <div class="carousel-container carousel-container-decorated">
                <div class="carousel {{ grid }} {{ compact }} {{ loadjs }}"
                     data-config="{{ config_json }}">
                    {% for card in cards %}
                        {{ card | safe }}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
{% endmacro %}
{% if show is defined %}
    {{ book_carousel(show, title, url, key, grid, compact, loadjs, config_json, cards, count, shelf) }}
{% endif %}
