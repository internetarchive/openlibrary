{#
    Renders a single carousel card. Converted from the old Templetor template
    templates/books/custom_carousel_card.html. Data is gathered in Python
    via get_carousel_card_data() (see partials.py) — like
    ReadingGoalProgressPartial — since Jinja has no `hasattr` and some checks
    (get_cover_url, get_waitinglist_size) can hit the DB.

    LoanStatus is still Templetor (bridged) per issue #13570;
    `loan_status_html` is pre-rendered in Python via render_macro("LoanStatus").
#}
{% from "TruncateString.html.jinja" import truncate_string %}
{% from "FormatExpiry.html.jinja" import format_expiry %}
<div class="book carousel__item">
    <div class="book-cover">
        <div class="book-cover-wrapper">
            {% if loan %}
                {% if expiry_utc or waitlist_size or not is_bookreader %}
                    <div class="loan-overlay-badge">
                        {% if expiry_utc %}
                            {{ format_expiry(expiry_utc, expiry_display) }}
                        {% endif %}
                        {% if waitlist_size %}
                            <div class="loan-overlay-badge__waitlist">
                                {{ ngettext("1 person waiting", "%(count)d people waiting", waitlist_size, count=waitlist_size) }}
                            </div>
                        {% endif %}
                        {% if not is_bookreader %}
                            <div class="loan-overlay-badge__not-bookreader">
                                {% if loan.get('expiry') is none %}
                                    <span class="loan-overlay-badge__not-downloaded">{{ _("Not yet downloaded.") }}</span>
                                    <br />
                                    <a href="{{ loan.get('loan_link') }}"
                                       class="loan-overlay-badge__download-link">{{ _("Download Now") }}</a>
                                {% else %}
                                    <span class="loan-overlay-badge__ade-notice">{{ _("Return via ADE") }}</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            {% elif key == "loans" %}
                <div class="loan-overlay-badge loan-overlay-badge--expired">
                    <span class="loan-overlay-badge__expired-label">{{ _("Loan Expired") }}</span>
                </div>
            {% endif %}
            <a href="{{ url }}"
               data-ol-link-track="BookCarousel|CoverClick|{{ key }}">
                {% if cover_url %}
                    <img class="bookcover"
                         loading="lazy"
                         title="{{ title }}{{ byline }}"
                         alt="{{ title }}{{ byline }}"
                         {% if lazy and layout == 'carousel' %} data-lazy="{{ cover_url }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" {% else %} src="{{ cover_url }}" {% endif %} />
                {% else %}
                    <div class="carousel__item__blankcover" title="{{ title }}">
                        <div class="carousel__item__blankcover--title">{{ truncate_string(title, 70) }}</div>
                        {% if author_names %}
                            <div class="carousel__item__blankcover--authors">{{ truncate_string(author_names | join(', '), 30) }}</div>
                        {% endif %}
                    </div>
                {% endif %}
            </a>
        </div>
    </div>
    <div class="ol-action-row">
        <div class="ol-macro-wrapper">{{ loan_status_html }}</div>
        {% if loan and loan.get('resource_type') == 'bookreader' %}
            <div class="ol-return-wrapper cta-button-group">
                <form action="/borrow/ia/{{ loan.get('ocaid') }}"
                      method="post"
                      class="return-form"
                      data-i18n="{{ return_confirm_i18n }}">
                    <input type="hidden" name="action" value="return" />
                    <input type="hidden" name="redirect" value="{{ request_fullpath }}" />
                    <button type="submit"
                            class="cta-btn cta-btn--available"
                            title="{{ _('Return book') }}"
                            aria-label="{{ _('Return book') }}"
                            data-ol-link-track="BookCarousel|ReturnClick|{{ key }}">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             height="20px"
                             viewBox="0 -960 960 960"
                             width="20px"
                             fill="#FFFFFF">
                            <path d="M288-192v-72h288q50 0 85-35t35-85q0-50-35-85t-85-35H330l93 93-51 51-180-180 180-180 51 51-93 93h246q80 0 136 56t56 136q0 80-56 136t-136 56H288Z" />
                        </svg>
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
</div>
