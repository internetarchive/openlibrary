{# Takes `key`: the publisher path (e.g. /publishers/Penguin_Books) that matched no works. #}
{% set name = key.split("/")[-1].replace("_", " ") %}
<div class="page-heading-search-box">
    <span class="tools"><a href="/publishers" class="plain">{{ _("Publishers") }}</a> /</span>
    <h1>{{ name }}</h1>
    <p>{{ _("We couldn't find any books published by %(publisher)s.", publisher=name) }}</p>
    <h3 class="collapse">{{ _("Try something else?") }}</h3>
    <form action="/search/publishers" class="olform">
        <input type="text"
               name="q"
               size="100"
               class="larger"
               value=""
               aria-label="{{ _('Search publishers') }}" />
        <button type="submit" class="larger">{{ _("Search") }}</button>
    </form>
</div>
