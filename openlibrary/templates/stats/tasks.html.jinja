{#- /stats/tasks: who is editing the catalog, how much, and how the Tasks page and its community projects are doing. Numbers are
    rendered here; the charts are drawn by openlibrary/plugins/openlibrary/js/tasks_stats.js from /stats/tasks.json. -#}
{% macro metric_cards(cards, scope) %}
    <div class="tasks-stats__cards"
         role="group"
         data-scope="{{ scope }}"
         aria-label="{{ _('Metrics. Choose one to chart it.') }}"
         {% if page.scope != scope %}hidden{% endif %}>
        {% for card in cards %}
            <button type="button"
                    class="tasks-stats__card"
                    data-metric="{{ card.metric }}"
                    data-note="{{ card.note }}"
                    aria-pressed="{{ 'true' if loop.first else 'false' }}">
                <span class="tasks-stats__card-label">{{ card.label }}</span>
                <span class="tasks-stats__card-value">{{ card.value }}</span>
                {% if card.split %}
                    <span class="tasks-stats__split" aria-hidden="true">
                        <span class="tasks-stats__split-first"
                              style="width: {{ card.split.first_time_width }}%"></span>
                    </span>
                {% endif %}
                {#- Always rendered, so the script can fill them when the window changes -#}
                <span class="tasks-stats__card-detail">
                    {%- if card.split -%}
                        {{ _("%(returning)s returning · %(first_time)s first-time", returning=card.split.returning, first_time=card.split.first_time) }}
                    {%- else -%}
                        {{ card.detail }}
                    {%- endif -%}
                </span>
                <span class="tasks-stats__card-change{% if card.change %} tasks-stats__card-change--{{ card.change.direction }}{% endif %}"
                      {% if not card.change %}hidden{% endif %}>
                    {%- if card.change -%}
                        {{ _("%(change)s vs previous 28 days", change=("▲ " if card.change.direction == "up" else "▼ " if card.change.direction == "down" else "") ~ card.change.text) }}
                    {%- endif -%}
                </span>
            </button>
        {% endfor %}
    </div>
{% endmacro %}
{% set first_card = page.cards[page.scope][0] %}
<div id="contentHead" class="tasks-stats__head">
    <h1>{{ _("Editing Stats") }}</h1>
</div>
<div id="contentBody"
     class="tasks-stats"
     data-scope="{{ page.scope }}"
     data-i18n="{{ page.i18n | tojson | forceescape }}"
     data-min-sample="{{ page.guardrail.min_sample }}">
    <div class="tasks-stats__controls">
        <ol-segmented-control class="tasks-stats__scope" value="{{ page.scope }}" accessible-label="{{ _('Scope') }}">
            <ol-segment value="all">
                {{ _("All editing") }}
            </ol-segment>
            <ol-segment value="tasks">
                {{ _("Through Tasks") }}
            </ol-segment>
        </ol-segmented-control>
        <ol-toggle class="tasks-stats__compare" variant="button" checked label="{{ _('Compare to previous period') }}">
        </ol-toggle>
        <ol-segmented-control class="tasks-stats__window" value="28" accessible-label="{{ _('Period') }}">
            <ol-segment value="7">
                {{ _("Last 7 days") }}
            </ol-segment>
            <ol-segment value="28">
                {{ _("Last 28 days") }}
            </ol-segment>
        </ol-segmented-control>
    </div>
    {{ metric_cards(page.cards.all, "all") }}
    {{ metric_cards(page.cards.tasks, "tasks") }}
    <section class="tasks-stats__main">
        <div class="tasks-stats__chart-head">
            <h2 class="tasks-stats__chart-title">{{ first_card.label }}</h2>
            <span class="tasks-stats__chart-unit">{{ _("Per day") }}</span>
            <span class="tasks-stats__legend">
                <span class="tasks-stats__parts"></span>
                <span class="tasks-stats__legend-previous">{{ _("4 weeks earlier") }}</span>
            </span>
        </div>
        <div class="tasks-stats__controls">
            <ol-segmented-control class="tasks-stats__range" size="small" value="90" accessible-label="{{ _('Date range') }}">
                <ol-segment value="28">
                    {{ _("28 days") }}
                </ol-segment>
                <ol-segment value="90">
                    {{ _("90 days") }}
                </ol-segment>
                <ol-segment value="182">
                    {{ _("6 months") }}
                </ol-segment>
                <ol-segment value="365">
                    {{ _("12 months") }}
                </ol-segment>
            </ol-segmented-control>
            <ol-segmented-control class="tasks-stats__granularity" size="small" value="day" accessible-label="{{ _('Group by') }}">
                <ol-segment value="day">
                    {{ _("Day") }}
                </ol-segment>
                <ol-segment value="week">
                    {{ _("Week") }}
                </ol-segment>
                <ol-segment value="month">
                    {{ _("Month") }}
                </ol-segment>
            </ol-segmented-control>
        </div>
        <div class="tasks-stats__canvas tasks-stats__canvas--main">
            <canvas data-chart="main"
                    role="img"
                    aria-label="{{ _('Chart of the chosen metric over the chosen range') }}"></canvas>
        </div>
        <p class="tasks-stats__note tasks-stats__chart-note">{{ first_card.note }}</p>
    </section>
    <div class="tasks-stats__panels"
         data-scope="all"
         {% if page.scope != "all" %}hidden{% endif %}>
        <section class="tasks-stats__panel">
            <h2>{{ _("Share through Tasks") }}</h2>
            <p class="tasks-stats__note">
                {{ _("Tasks saves as a share of all edits, and Tasks editors as a share of all editors, by day.") }}
            </p>
            <p class="tasks-stats__figures">
                <span class="tasks-stats__legend-accent">{{ _("Of edits") }}</span>
                <span class="tasks-stats__legend-previous">{{ _("Of editors") }}</span>
            </p>
            <div class="tasks-stats__canvas">
                <canvas data-chart="share"
                        role="img"
                        aria-label="{{ _('Share of edits and of editors through Tasks, by day') }}"></canvas>
            </div>
        </section>
        <section class="tasks-stats__panel">
            <h2>{{ _("Traffic and editing") }}</h2>
            <p class="tasks-stats__note">
                {{ _("Visitors, edits, and edits per 1,000 visitors, by day. If visitors rise and the ratio holds, editing is keeping pace.") }}
            </p>
            <div class="tasks-stats__multiples">
                <div class="tasks-stats__multiple">
                    <span class="tasks-stats__multiple-label">{{ _("Visitors") }}</span>
                    <div class="tasks-stats__canvas tasks-stats__canvas--small">
                        <canvas data-chart="visitors"
                                role="img"
                                aria-label="{{ _('Visitors by day') }}"></canvas>
                    </div>
                </div>
                <div class="tasks-stats__multiple">
                    <span class="tasks-stats__multiple-label">{{ _("Edits") }}</span>
                    <div class="tasks-stats__canvas tasks-stats__canvas--small">
                        <canvas data-chart="edits" role="img" aria-label="{{ _('Edits by day') }}"></canvas>
                    </div>
                </div>
                <div class="tasks-stats__multiple">
                    <span class="tasks-stats__multiple-label">{{ _("Edits per 1,000 visitors") }}</span>
                    <div class="tasks-stats__canvas tasks-stats__canvas--small">
                        <canvas data-chart="ratio"
                                role="img"
                                aria-label="{{ _('Edits per 1,000 visitors by day') }}"></canvas>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="tasks-stats__panels"
         data-scope="tasks"
         {% if page.scope != "tasks" %}hidden{% endif %}>
        <section class="tasks-stats__panel tasks-stats__panel--wide">
            <h2>{{ _("Community projects") }}</h2>
            <p class="tasks-stats__note">
                {{ _("Details still missing across each project's books. A detail nobody could find counts as filled.") }}
            </p>
            <div class="tasks-stats__cards tasks-stats__cards--projects"
                 role="group"
                 aria-label="{{ _('Community projects. Choose one to chart it.') }}">
                {% for project in page.initiatives %}
                    <button type="button"
                            class="tasks-stats__card"
                            data-initiative="{{ project.slug }}"
                            aria-pressed="{{ 'true' if project.on else 'false' }}">
                        <span class="tasks-stats__card-label">{{ project.title }}</span>
                        <span class="tasks-stats__card-value">{{ project.percent }}</span>
                        <span class="tasks-stats__card-window">{{ _("of details filled") }}</span>
                    </button>
                {% endfor %}
            </div>
            {% for project in page.initiatives %}
                <p class="tasks-stats__figures"
                   data-initiative-figures="{{ project.slug }}"
                   {% if not project.on %}hidden{% endif %}>
                    <span>{{ _("<b>%(done)s of %(count)s</b> books complete", done=project.done, count=project.editions) | safe }}</span>
                    <span><b>{{ project.open }}</b> {{ _("details still open") }}</span>
                    <span><b>{{ project.not_found }}</b> {{ _("marked not found") }}</span>
                    <span>{{ project.people | safe }}</span>
                </p>
            {% endfor %}
            <div class="tasks-stats__canvas">
                <canvas data-chart="initiative"
                        role="img"
                        aria-label="{{ _('Details still open on the chosen project, by day') }}"></canvas>
            </div>
        </section>
        <section class="tasks-stats__panel">
            <h2>{{ _("Saves by field, last 28 days") }}</h2>
            <p class="tasks-stats__note">{{ _("Which details people are filling in.") }}</p>
            {% if page.saves_by_field %}
                <table class="tasks-stats__fields no-table-collapse">
                    <thead>
                        <tr>
                            <th scope="col">{{ _("Field") }}</th>
                            <th scope="col" class="tasks-stats__fields-count">{{ _("Saves") }}</th>
                            <th scope="col">{{ _("Share") }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in page.saves_by_field %}
                            <tr>
                                <td>{{ row.label }}</td>
                                <td class="tasks-stats__fields-count">{{ row.count }}</td>
                                <td>
                                    <span class="tasks-stats__fields-share">
                                        <span class="tasks-stats__fields-bar" style="width: {{ row.width }}%"></span>
                                        {{ row.share }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>{{ _("No Tasks saves in the last 28 days.") }}</p>
            {% endif %}
        </section>
        <section class="tasks-stats__panel">
            <h2>{{ _("Guardrail") }}</h2>
            <p class="tasks-stats__note">
                {{ _("Saves whose value is no longer on the record: undone, reverted or changed by a later edit, over the 28 days to each day. The dashed line is the same check on the same fields filled outside Tasks, by people editing a record directly.") }}
            </p>
            <p class="tasks-stats__figures">
                <span class="tasks-stats__legend-tasks">
                    {% if page.guardrail.tasks.share %}
                        <b>{{ page.guardrail.tasks.share }}</b> {{ _("of Tasks saves undone") }}
                    {% else %}
                        {{ _("Tasks saves: too few to compare yet") }}
                    {% endif %}
                </span>
                <span class="tasks-stats__legend-previous">
                    {% if page.guardrail.other.share %}
                        <b>{{ page.guardrail.other.share }}</b> {{ _("of fills outside Tasks undone") }}
                    {% else %}
                        {{ _("Fills outside Tasks: too few to compare yet") }}
                    {% endif %}
                </span>
            </p>
            <p class="tasks-stats__note">
                {{ _("Last 28 days: %(tasks_undone)s of %(tasks)s Tasks saves and %(other_undone)s of %(other)s fills outside Tasks. A share shows once there are %(min)s.", tasks_undone=page.guardrail.tasks.undone, tasks=page.guardrail.tasks.total, other_undone=page.guardrail.other.undone, other=page.guardrail.other.total, min=page.guardrail.min_sample) }}
            </p>
            <div class="tasks-stats__canvas">
                <canvas data-chart="undone"
                        role="img"
                        aria-label="{{ _('Share of Tasks saves undone, and of fills outside Tasks, by day') }}"></canvas>
            </div>
        </section>
    </div>
    {#- Every note on when the numbers are gathered lives here, so the sections above only say what they count -#}
    <ul class="tasks-stats__note tasks-stats__fine-print">
        <li>{{ _("Counts are gathered every hour, so today's figures fill in as the day goes on.") }}</li>
        <li>{{ _("Community project progress is counted nightly.") }}</li>
        <li>
            {{ _("Visitors are unique IP addresses a day, counted only on openlibrary.org. Today's count is left out until the day is over.") }}
        </li>
        <li>{{ _("Edit totals start on %(date)s, so longer ranges begin partway through.", date=page.edits_since) }}</li>
    </ul>
</div>
