{# Takes `nav` (SearchNav), `inside_nav` (InsideNav), `q`, `page`, `results_per_page`,
   `rows` (the rendered hit rows), `total`, `commified_total`, `range_start`,
   `total_pages`, `language` ((code, name) or None), `readable`, `was_auto_phrased`,
   `used_fallback`, `opted_out`, `error` and `empty_reason`. #}
{% from "search/searchbox.html.jinja" import searchbox %}
{% from "OlPagination.html.jinja" import ol_pagination %}
{# Totals are estimates ("about"). Filtered totals include hits the page dropped,
   so a "1 - 20 of" range would skip numbers; show the bare total instead. #}
{% set filtered = readable or language %}
<div id="contentHead">
    <h1>{{ _("Search Inside") }}</h1>
</div>
<div id="contentBody">
    {% include "SearchNavigation.html.jinja" %}
    <div class="search-controls">
        <form class="siteSearch search-row olform" action="/search/inside">
            {{ searchbox(q=q, autofocus=True) }}
            {% if language %}
                <input type="hidden" name="language" value="{{ language[0] }}">
            {% endif %}
            {% if readable %}
                <input type="hidden" name="readable" value="true">
            {% endif %}
        </form>
        {% if q %}
            {# Wired by SearchFilterBar.js. No sort (FTS only ranks by relevance) and no
               toggle count (it would need a second FTS query with approximate totals). #}
            <div class="search-filter-row" id="search-filter-row">
                <ol-toggle variant="button" label="{{ _('Readable Only') }}" accessible-label="{{ _('Filter by availability') }}">
                </ol-toggle>
                <ol-select-popover label="{{ _('Language') }}" placeholder="{{ _('Search languages…') }}" unselected-heading="{{ _('Choose one language') }}" suggestions-heading="{{ _('Choose one language') }}" loading-label="{{ _('Loading…') }}" aria-label="{{ _('Filter by language') }}">
                </ol-select-popover>
            </div>
            {% if total %}
                {# One row: the count, then how the query was read (wraps under the count on narrow screens). #}
                <div class="search-results-stats search-results-stats--wrap">
                    {% if filtered or not rows %}
                        <span>{{ ngettext('About %(total)s result', 'About %(total)s results', total, total=commified_total) }}</span>
                    {% else %}
                        <span>{{ ngettext('%(start)s - %(end)s of about %(total)s result', '%(start)s - %(end)s of about %(total)s results', total, start=range_start, end=range_start + rows | length - 1, total=commified_total) }}</span>
                    {% endif %}
                    {% if used_fallback %}
                        <span class="search-results-stats__note">{{ _('No exact matches for "%(query)s". Showing books containing all of these words.', query=q) }}</span>
                    {% elif was_auto_phrased %}
                        {# Keep the whole message translatable so its link can be repositioned for each language. #}
                        {# Markup, or Jinja's gettext escapes the anchor along with the variables. #}
                        {% set all_words_link = ('<a href="%s">' % (inside_nav.all_words_href | force_escape)) | safe %}
                        <span class="search-results-stats__note">{{ _('Showing exact matches for "%(query)s". %(link_start)sSearch for all of these words instead.%(link_end)s', query=q, link_start=all_words_link, link_end='</a>' | safe) }}</span>
                    {% elif opted_out %}
                        {% set phrase_link = ('<a href="%s">' % (inside_nav.phrase_href | force_escape)) | safe %}
                        <span class="search-results-stats__note">{{ _('Showing all of these words, in any order. %(link_start)sSearch for the exact phrase instead.%(link_end)s', link_start=phrase_link, link_end='</a>' | safe) }}</span>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
    {% if error %}
        <div class="searchResultsError">{{ error }}</div>
    {% elif empty_reason == 'no_matches' %}
        <div class="search-no-results">{{ _("No results found. Try a different word or phrase.") }}</div>
    {% elif empty_reason == 'filtered_out' %}
        <div class="search-no-results">{{ _("None of the matches on this page can be shown with these filters. Try another page or remove a filter.") }}</div>
    {% elif empty_reason == 'past_end' %}
        <div class="search-no-results">{{ _("No more results. Try an earlier page.") }}</div>
    {% endif %}
    {% if rows %}
        <div class="resultsContainer search-results-container">
            <div id="searchResults">
                <ul class="list-books list-books--fulltext">
                    {% for row in rows %}{{ row }}{% endfor %}
                </ul>
                {{ ol_pagination(page, total_pages) }}
            </div>
        </div>
    {% endif %}
</div>
