{#
Browse menu rendered with the <ol-popover> web component (see
openlibrary/components/lit/OlPopover.js) instead of a native <details>
dropdown. Imported as a macro by shell/header.html.jinja.

Takes the full destination list plus the number to promote to featured rows,
and derives the featured/simple split itself, so callers pass one list.
#}
{% macro browse_popover(browse_links, featured_count, track_prefix) %}
    {% set featured_links = browse_links[:featured_count] %}
    {% set simple_links = browse_links[featured_count:] %}
    {% set featured_detail = {
        'Subjects': _('Browse books by topic'),
        'Trending': _('Most popular right now'),
        'Explore': _('Browse the virtual shelves'),
        'Lists': _('Reader-curated collections'),
    } %}
    {% set nav_icons = {
        "Subjects": "wand",
        "Trending": "trending-up",
        "Explore": "compass",
        "Lists": "list",
        "Collections": "library-big",
        "K12Library": "graduation-cap",
        "BookTalks": "mic",
        "RandomBook": "dices",
        "AdvancedSearch": "search"
    } %}
    <div class="browse-component header-dropdown">
        <ol-popover class="nav-popover browse-popover" placement="bottom-center" aria-label="{{ _('Browse') }}" data-ol-open-track="{{ track_prefix }}|BrowseOpen">
            <button type="button"
                    slot="trigger"
                    class="ol-button-static ol-button-static--ghost nav-popover__trigger">
                {{ icon("book-open-text", size="sm", extra_class="ol-button-static__icon") }}
                {{ _("Browse") }}
                {{ icon("chevron-down", size="sm", extra_class="down-arrow") }}
            </button>
            <div class="nav-popover__panel">
                <div class="nav-popover__featured">
                    {% for link in featured_links %}
                        <a class="nav-feature"
                           href="{{ link.href }}"
                           data-ol-link-track="{{ track_prefix }}|{{ link.track }}|{{ loop.index }}">
                            <span class="nav-feature__icon">{{ icon(nav_icons.get(link.track, 'link')) }}</span>
                            <span class="nav-feature__body">
                                <span class="nav-feature__title">{{ link.text }}</span>
                                {% if link.track in featured_detail %}
                                    <span class="nav-feature__desc">{{ featured_detail[link.track] }}</span>
                                {% endif %}
                            </span>
                        </a>
                    {% endfor %}
                </div>
                <hr class="nav-popover__divider">
                <ul class="nav-popover__links">
                    {% for link in simple_links %}
                        <li>
                            <a class="nav-popover__link"
                               href="{{ link.href }}"
                               data-ol-link-track="{{ track_prefix }}|{{ link.track }}|{{ featured_count + loop.index }}">
                                {{- icon(nav_icons.get(link.track, 'link'), size="sm") -}}
                                {{ link.text }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </ol-popover>
    </div>
{% endmacro %}
