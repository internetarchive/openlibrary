{#
My Books menu: an <ol-popover> styled like the Browse popover (shared .nav-popover
rules in header-bar.css). Featured rows lead, then each further group of links is
set off by a divider. Imported as a macro by shell/header.html.jinja.

Analytics mirror shell/browse_popover.html.jinja: "category|action|label", where the
label is each destination's 1-based rank in visual top-to-bottom order.

Destinations come from mybooks_links() in openlibrary/core/shell/nav.py; icons and
blurbs are presentation and live here, with fallbacks so a new destination can't
500 every page.
#}
{% macro mybooks_popover(groups, track_prefix) %}
    {% set featured_detail = {
        "MyBooks": _("Your shelves at a glance"),
        "Loans": _("Borrowed books and history"),
        "MyLists": _("Books you have collected"),
    } %}
    {% set nav_icons = {
        "MyBooks": "layout-grid",
        "Loans": "clock",
        "MyLists": "list",
        "WantToRead": "bookmark",
        "CurrentlyReading": "book-open",
        "AlreadyRead": "circle-check",
        "StoppedReading": "circle-pause",
        "MyFeed": "user",
        "MyNotes": "sticky-note",
        "MyReviews": "star",
        "ReadingStats": "trending-up",
        "ImportExport": "arrow-up-down"
    } %}
    {% set counter = namespace(rank=0) %}
    <div class="mybooks-component header-dropdown">
        <ol-popover class="nav-popover mybooks-popover" placement="bottom-center" aria-label="{{ _('My Books') }}" data-ol-open-track="{{ track_prefix }}|MyBooksOpen">
            <button type="button"
                    slot="trigger"
                    class="ol-button-static ol-button-static--ghost nav-popover__trigger">
                {{ icon("bookmark", size="sm", extra_class="ol-button-static__icon") }}
                {{ _("My Books") }}
                {{ icon("chevron-down", size="sm", extra_class="down-arrow") }}
            </button>
            <div class="nav-popover__panel">
                <div class="nav-popover__featured">
                    {% for link in groups[0] %}
                        {% set counter.rank = counter.rank + 1 %}
                        <a class="nav-feature"
                           href="{{ link.href }}"
                           data-ol-link-track="{{ track_prefix }}|{{ link.track }}|{{ counter.rank }}">
                            <span class="nav-feature__icon">{{ icon(nav_icons.get(link.track, 'link')) }}</span>
                            <span class="nav-feature__body">
                                <span class="nav-feature__title">{{ link.text }}</span>
                                {% if link.track in featured_detail %}
                                    <span class="nav-feature__desc">{{ featured_detail[link.track] }}</span>
                                {% endif %}
                            </span>
                        </a>
                    {% endfor %}
                </div>
                {% for group in groups[1:] %}
                    <hr class="nav-popover__divider">
                    <ul class="nav-popover__links">
                        {% for link in group %}
                            {% set counter.rank = counter.rank + 1 %}
                            <li>
                                <a class="nav-popover__link"
                                   href="{{ link.href }}"
                                   data-ol-link-track="{{ track_prefix }}|{{ link.track }}|{{ counter.rank }}">
                                    {{- icon(nav_icons.get(link.track, 'link'), size="sm") -}}
                                    {{ link.text }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </div>
        </ol-popover>
    </div>
{% endmacro %}
