{# djlint:off H016,H030 #}
{# The <title> and <meta name="description"> live in the included
   shell/head.html.jinja. djLint lints each file in isolation, so it can't see
   them here. #}
<!DOCTYPE html>
<html lang="{{ layout.lang }}">
    {% include "shell/head.html.jinja" %}
    <body class="{{ layout.body_class }}"
          {% for attr in layout.body_attrs %} {{ attr | safe }}{% endfor %}>
        <script>
            // Provide a signal that JS will load
            document.body.className += ' client-js';
        </script>
        {% if layout.show_ol_shell %}
            <a class="skip-link" href="#test-body-mobile">{{ _("Skip to main content") }}</a>
        {% endif %}
        <span id="top"></span>
        <div id="offline-info">{{ _("It looks like you're offline.") }}</div>
        {% if layout.show_ol_shell %}
            {% include "shell/alert.html.jinja" %}
            {% include "shell/header.html.jinja" %}
            {{ render_templetor_template("my_books/shelf_button_i18n") }}
        {% endif %}
        <main {% if layout.show_ol_shell %} id="test-body-mobile" tabindex="-1"{% endif %}>
            {% if layout.show_ol_shell %}
                {% if layout.flash_messages %}
                    <div class="flash-messages">
                        {% for flash in layout.flash_messages %}
                            <div class="{{ flash['type'] }}"><span>{{ flash['message'] }}</span></div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if layout.announcement_banner %}
                    {% include "shell/banner.html.jinja" %}
                {% endif %}
            {% endif %}
            {% block content %}
                {{ page | safe }}
            {% endblock %}
        </main>
        {% if layout.show_ol_shell %}
            <div class="clearfix"></div>
            {% include "shell/footer.html.jinja" %}
        {% endif %}
        {% if layout.is_debug %}
            {% include "shell/stats.html.jinja" %}
        {% endif %}
        {% if not layout.is_bot %}
            <script src="/cdn/archive.org/athena.js" type="text/javascript"></script>
        {% endif %}
        <script src="{{ static_url('build/js/all.js') }}" type="module"></script>
        <script src="{{ static_url('build/components/production/ol-components.js') }}"
                type="module"></script>
        <div class="analytics-stats-time-calculator"
             data-time="{{ layout.total_time_ms }}"></div>
    </body>
</html>
{# djlint:on H016,H030 #}
