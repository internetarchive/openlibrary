{#-
  The banner an edit-page save lands on: the thank-you and, at most once a day, a link per Tasks project.
  `layout.edit_saved` comes from openlibrary/contribute/pitch.py. Closing a banner that names projects, or
  following one of its links, sets `dismiss_cookie` (js/banner/index.js), which keeps the projects away
  until a new one starts.
-#}
{% if layout.edit_saved %}
    {% set saved = layout.edit_saved %}
    <ol-banner class="edit-saved" variant="success" appearance="plain" dismissible label-close="{{ _('Close') }}" {% if saved.projects %} dismiss-id="{{ saved.dismiss_cookie }}" data-cookie-duration-days="{{ saved.dismiss_days }}" data-dismiss-on-link{% endif %}>
        {{ icon("circle-check", size="sm", slot="icon") }}
        <p class="edit-saved__thanks">{{ _("Thank you for improving the Open Library catalog!") }}</p>
        {% if saved.projects %}
            <div class="edit-saved__projects">
                <span class="edit-saved__label" id="edit-saved-projects">{{ _("Keep going with a community project:") }}</span>
                <ol-chip-group aria-labelledby="edit-saved-projects">
                    {% for project in saved.projects %}
                        <ol-chip size="small" href="{{ project.url }}" {% if project.left %}count="{{ project.left }}"{% endif %} data-ol-link-track="EditSaved|Initiative|{{ project.slug }}">{{ project.title }}</ol-chip>
                    {% endfor %}
                    {% if saved.more %}
                        <ol-chip size="small" href="/tasks" data-ol-link-track="EditSaved|AllProjects">
                            {{ _("See all projects") }}
                        </ol-chip>
                    {% endif %}
                </ol-chip-group>
            </div>
        {% endif %}
    </ol-banner>
{% endif %}
