{#
  /developers/more-like-this — the work page's subject-based related-books
  query next to the same slot asked for with `like:`.

  Both queries are built server-side (see
  openlibrary/plugins/openlibrary/more_like_this.py) and printed under their
  carousel, so what ran is always visible. The carousels are filled from
  /search.json in the browser: a ten-book sample is twenty solr queries, and
  waiting on them serially server-side would make the page unusable.
#}
{% set data = data or {"count": 10, "method": "random", "pool": "all", "rows": [], "counts": [10], "methods": [], "pools": [], "mlt_controls": [], "share_url": "", "pinned": false, "message": ""} %}
<div class="mlt">
    <header class="mlt__masthead">
        <h1 class="mlt__title">More Like This</h1>
        <p class="mlt__blurb">
            The work page recommends similar books by OR-ing a work's subjects together. Solr's
            more-like-this parser, reached with the <code>like:</code> search field, picks its own
            terms from the seed work and weights them by how distinctive they are. Both carousels
            below are filtered to borrowable-or-better and exclude the work's own authors, so they
            differ only in how similarity is decided.
        </p>
    </header>
    <form class="mlt__controls"
          id="mlt-controls"
          method="get"
          action="/developers/more-like-this">
        <label class="mlt__control">
            <span>Choose</span>
            <select name="count">
                {% for choice in data.counts %}
                    <option value="{{ choice }}" {% if choice == data.count %}selected{% endif %}>{{ choice }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="mlt__control">
            <select name="method">
                {% for choice in data.methods %}
                    <option value="{{ choice.id }}"
                            {% if choice.id == data.method %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label class="mlt__control">
            <span>from</span>
            <select name="pool">
                {% for choice in data.pools %}
                    <option value="{{ choice.id }}"
                            {% if choice.id == data.pool %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </label>
        {# The route samples only when `go` is present, so landing on the page
           costs no solr queries. #}
        <button class="mlt__go" type="submit" name="go" value="1">Go</button>
        {% if data.pinned %}
            <span class="mlt__pinned-note">Showing a shared set of books — press Go to sample fresh ones instead.</span>
        {% endif %}
    </form>
    {# Same form as the sampling controls, so changing a knob and pressing Go
       re-runs with both. Empty inputs are dropped by `_mlt_controls`, so only
       edited knobs end up in the url and in the share link. #}
    <details class="mlt__tuning"
             {% if data.mlt_controls | selectattr("is_default", "false") | list %}open{% endif %}>
        <summary class="mlt__tuning-summary">
            More-like-this tuning
            <span class="mlt__tuning-hint">what solr uses to decide two works are alike</span>
        </summary>
        <div class="mlt__knobs">
            {% for control in data.mlt_controls %}
                <div class="mlt__knob {% if control.name == 'qf' %}mlt__knob--wide{% endif %}">
                    <label class="mlt__knob-label" for="{{ control.param }}">
                        <code>{{ control.name }}</code>
                        {% if not control.is_default %}<span class="mlt__knob-changed">changed</span>{% endif %}
                    </label>
                    <input class="mlt__knob-input"
                           id="{{ control.param }}"
                           name="{{ control.param }}"
                           form="mlt-controls"
                           value="{{ control.value }}"
                           placeholder="{{ control.default }}"
                           autocomplete="off">
                    <p class="mlt__knob-help">{{ control.help }}</p>
                    <p class="mlt__knob-default">default <code>{{ control.default }}</code></p>
                </div>
            {% endfor %}
        </div>
    </details>
    {% if data.share_url %}
        <p class="mlt__share">
            <a href="{{ data.share_url }}">Share this comparison</a>
            <span class="mlt__share-hint">— pins these {{ data.rows | length }} books and the tuning above, so someone else sees the same thing</span>
        </p>
    {% endif %}
    {% if data.message %}
        <p class="mlt__empty">{{ data.message }}</p>
    {% elif not data.rows %}
        <p class="mlt__empty">Pick a sample and press Go.</p>
    {% endif %}
    {% for row in data.rows %}
        <section class="mlt__row">
            <div class="mlt__seed">
                <ol-book-cover class="mlt__seed-cover" size="small" src="{%- if row.cover_id -%}//covers.openlibrary.org/b/id/{{ row.cover_id }}-M.jpg{%- endif -%}" book-title="{{ row.title }}" authors="{{ row.authors }}" year="{{ row.year }}" href="{{ row.key }}">
                </ol-book-cover>
                <div class="mlt__seed-meta">
                    <h2 class="mlt__seed-title"><a href="{{ row.key }}">{{ row.title }}</a></h2>
                    {% if row.authors %}<p class="mlt__seed-authors">{{ row.authors }}</p>{% endif %}
                    <p class="mlt__seed-key"><a href="/search?q=like:{{ row.key }}"><code>like:{{ row.key }}</code></a></p>
                    {% if row.subjects %}
                        <ul class="mlt__subjects">
                            {% for subject in row.subjects %}<li>{{ subject }}</li>{% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
            <div class="mlt__panes">
                {# `data-mlt-query` is what the script fetches; an empty one renders
                   as a stated reason rather than an empty rail. #}
                <div class="mlt__pane"
                     data-mlt-pane
                     data-mlt-kind="current"
                     data-mlt-query="{{ row.baseline_query }}">
                    <h3 class="mlt__pane-title">Current <span class="mlt__timing" data-mlt-timing></span></h3>
                    <div class="mlt__rail" data-mlt-rail>
                        {% if row.baseline_query %}
                            <p class="mlt__status">Loading…</p>
                        {% else %}
                            <p class="mlt__status">No query — this work has no usable subjects, so the current carousel shows nothing.</p>
                        {% endif %}
                    </div>
                    {% if row.baseline_query %}
                        <code class="mlt__query">{{ row.baseline_query }}</code>
                    {% endif %}
                </div>
                <div class="mlt__pane"
                     data-mlt-pane
                     data-mlt-kind="like"
                     data-mlt-query="{{ row.mlt_query }}">
                    <h3 class="mlt__pane-title">
                        <code>like:</code>
                        <span class="mlt__timing" data-mlt-timing></span>
                    </h3>
                    <div class="mlt__rail" data-mlt-rail>
                        <p class="mlt__status">Loading…</p>
                    </div>
                    <code class="mlt__query">{{ row.mlt_query }}</code>
                </div>
            </div>
        </section>
    {% endfor %}
</div>
<style>
    .mlt {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 16px 48px;
        font-family: var(--font-family-body);
        color: var(--color-text-primary);
    }
    .mlt__masthead { padding: 24px 0 8px; }
    .mlt__title {
        font-family: var(--font-family-display, var(--font-family-body));
        margin: 0 0 8px;
    }
    .mlt__blurb {
        max-width: 78ch;
        margin: 0;
        color: var(--color-text-secondary);
        line-height: 1.5;
    }
    .mlt__controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin: 20px 0 8px;
        padding: 12px;
        background: var(--color-surface-raised);
        border: 1px solid var(--color-border-subdued);
        border-radius: var(--border-radius-medium, 6px);
    }
    .mlt__control { display: flex; align-items: center; gap: 6px; }
    .mlt__controls select { padding: 5px 6px; font: inherit; }
    .mlt__go { padding: 6px 16px; font: inherit; cursor: pointer; }
    .mlt__empty { color: var(--color-text-secondary); }

    .mlt__row {
        padding: 20px 0;
        border-top: 1px solid var(--color-border-subdued);
    }
    .mlt__seed { display: flex; gap: 14px; align-items: flex-start; }
    .mlt__seed-cover { width: 72px; flex: none; }
    .mlt__seed-meta { min-width: 0; }
    .mlt__seed-title { margin: 0 0 2px; font-size: 1.1rem; }
    .mlt__seed-authors,
    .mlt__seed-key { margin: 0 0 4px; color: var(--color-text-secondary); font-size: 0.9rem; }
    .mlt__subjects {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin: 6px 0 0;
        padding: 0;
        list-style: none;
    }
    .mlt__subjects li {
        padding: 1px 7px;
        background: var(--color-surface-sunken);
        border-radius: 999px;
        font-size: 0.75rem;
        color: var(--color-text-secondary);
    }

    /* Two columns so the same rank sits at the same x in both queries, which is
       the whole point of the page. Stacks below 900px. */
    .mlt__panes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 14px;
    }
    @media (max-width: 900px) {
        .mlt__panes { grid-template-columns: minmax(0, 1fr); }
    }
    .mlt__pane { min-width: 0; }
    .mlt__pane-title {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin: 0 0 8px;
        font-size: 0.95rem;
    }
    .mlt__timing {
        font-weight: normal;
        font-size: 0.8rem;
        color: var(--color-text-secondary);
        /* Counts, so they must not reflow the heading as they land. */
        font-variant-numeric: tabular-nums;
    }
    .mlt__status { margin: 0; color: var(--color-text-secondary); font-size: 0.85rem; }
    .mlt__query {
        display: block;
        margin-top: 8px;
        padding: 6px 8px;
        background: var(--color-surface-sunken);
        border-radius: 4px;
        font-size: 0.72rem;
        line-height: 1.45;
        color: var(--color-text-secondary);
        overflow-wrap: anywhere;
    }
    .mlt__pinned-note,
    .mlt__share-hint,
    .mlt__tuning-hint { color: var(--color-text-secondary); font-size: 0.85rem; }

    .mlt__tuning {
        margin: 0 0 12px;
        padding: 10px 12px;
        background: var(--color-surface-raised);
        border: 1px solid var(--color-border-subdued);
        border-radius: var(--border-radius-medium, 6px);
    }
    .mlt__tuning-summary { cursor: pointer; font-weight: 600; }
    .mlt__knobs {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 14px;
        margin-top: 12px;
    }
    /* qf holds a field list, which is far longer than the numeric knobs. */
    .mlt__knob--wide { grid-column: span 2; }
    .mlt__knob-label { display: flex; align-items: baseline; gap: 6px; font-size: 0.9rem; }
    .mlt__knob-changed {
        padding: 0 6px;
        background: var(--color-surface-sunken);
        border-radius: 999px;
        font-size: 0.7rem;
        color: var(--color-text-secondary);
    }
    .mlt__knob-input {
        width: 100%;
        margin-top: 4px;
        padding: 5px 6px;
        font: inherit;
        font-size: 0.85rem;
        box-sizing: border-box;
    }
    .mlt__knob-help {
        margin: 5px 0 0;
        font-size: 0.78rem;
        line-height: 1.4;
        color: var(--color-text-secondary);
    }
    .mlt__knob-default { margin: 3px 0 0; font-size: 0.72rem; color: var(--color-text-secondary); }
    .mlt__share { margin: 0 0 12px; }

    .mlt__card { display: block; }
    .mlt__card-title {
        margin: 4px 0 0;
        font-size: 0.75rem;
        line-height: 1.3;
        /* Titles vary wildly in length; clamp so every card in a rail is the
           same height and the rail doesn't jump as pages change. */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
<script>
    (function () {
        const LIMIT = 12;
        const FIELDS = 'key,title,author_name,first_publish_year,cover_i';

        function card(doc) {
            const wrapper = document.createElement('div');
            wrapper.className = 'mlt__card';

            const cover = document.createElement('ol-book-cover');
            cover.setAttribute('size', 'small');
            cover.setAttribute('src', doc.cover_i ? `//covers.openlibrary.org/b/id/${doc.cover_i}-M.jpg` : '');
            cover.setAttribute('book-title', doc.title || doc.key);
            cover.setAttribute('authors', (doc.author_name || []).join(', '));
            cover.setAttribute('year', doc.first_publish_year || '');
            cover.setAttribute('href', doc.key);
            wrapper.appendChild(cover);

            const title = document.createElement('p');
            title.className = 'mlt__card-title';
            title.textContent = doc.title || doc.key;
            wrapper.appendChild(title);

            return wrapper;
        }

        // Read the tuning straight off the page's own url, so what the carousels
        // request is always what the address bar (and the share link) says.
        const mltParams = new URLSearchParams();
        for (const [key, value] of new URLSearchParams(location.search)) {
            if (key.startsWith('mlt_') && value) mltParams.set(key, value);
        }

        async function fill(pane) {
            const query = pane.dataset.mltQuery;
            const rail = pane.querySelector('[data-mlt-rail]');
            const timing = pane.querySelector('[data-mlt-timing]');
            if (!query) return;

            // Only the more-like-this side has a {!mlt} clause for them to affect.
            const tuning = pane.dataset.mltKind === 'like' && mltParams.size ? `&${mltParams}` : '';
            const url = `/search.json?q=${encodeURIComponent(query)}&fields=${FIELDS}&limit=${LIMIT}${tuning}`;
            const started = performance.now();
            let payload;
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                payload = await response.json();
            } catch (error) {
                rail.innerHTML = '';
                const failed = document.createElement('p');
                failed.className = 'mlt__status';
                // A `like:` seed missing from the index makes solr reject the
                // whole query, so a failure here is a result worth reading.
                failed.textContent = `Query failed: ${error.message}`;
                rail.appendChild(failed);
                return;
            }
            const elapsed = Math.round(performance.now() - started);

            const docs = payload.docs || [];
            timing.textContent = `${payload.num_found ?? 0} found · ${elapsed} ms`;
            rail.innerHTML = '';

            if (!docs.length) {
                const empty = document.createElement('p');
                empty.className = 'mlt__status';
                empty.textContent = 'No results.';
                rail.appendChild(empty);
                return;
            }

            const carousel = document.createElement('ol-carousel');
            carousel.setAttribute('label', `Results for ${query}`);
            docs.forEach((doc) => carousel.appendChild(card(doc)));
            rail.appendChild(carousel);
        }

        // Sequential on purpose: ten rows is twenty queries, and firing them all
        // at once buries the solr this page exists to measure, making the
        // reported timings meaningless.
        (async function () {
            for (const pane of document.querySelectorAll('[data-mlt-pane]')) {
                await fill(pane);
            }
        })();
    })();
</script>
