{% endset %}
{% set SHORT %}
    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.
{% endset %}
{% macro demos() %}
    {% call ex.example("Default", "Content collapses to 80px, the default max-height.", output_style="max-width: 360px;") %}
        <ol-read-more>
            <p>{{ LONG }}</p>
        </ol-read-more>
    {% endcall %}
    {% call ex.example("Custom collapsed height", "Any max-height other than the default needs a matching min-height on the host — max-height plus 41px (or plus 27px with label-size=\"small\") — so the page doesn't shift as the component measures itself.", output_style="max-width: 360px;") %}
        <ol-read-more max-height="160px" style="min-height: 201px">
            <p>{{ LONG }}</p>
        </ol-read-more>
    {% endcall %}
    {% call ex.example("Custom button text", output_style="max-width: 360px;") %}
        <ol-read-more more-text="Show more" less-text="Show less">
            <p>{{ LONG }}</p>
        </ol-read-more>
    {% endcall %}
    {% call ex.example("Custom background color", "Match the gradient fade to your container's background.", output_style="max-width: 360px; background: var(--blue-50); padding: 12px 12px 0; border-radius: var(--border-radius-card);") %}
        <ol-read-more background-color="var(--blue-50)">
            <p>{{ LONG }}</p>
        </ol-read-more>
    {% endcall %}
    {% call ex.example("Small label size", output_style="max-width: 360px;") %}
        <ol-read-more label-size="small">
            <p>{{ LONG }}</p>
        </ol-read-more>
    {% endcall %}
    {% call ex.example("Content that fits", "No toggle renders unless the content runs at least four lines past the limit — hiding less than that isn't worth a control.", output_style="max-width: 360px;") %}
        <ol-read-more>
            <p>{{ SHORT }}</p>
        </ol-read-more>
    {% endcall %}
{% endmacro %}
