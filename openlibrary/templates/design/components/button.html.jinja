{% import "design/_example.html.jinja" as ex %}
{% macro demos() %}
    {% call ex.example("Variants", "Secondary is the default — a bare <ol-button> renders as secondary.") %}
        <ol-button>
            Secondary
        </ol-button>
        <ol-button variant="primary">
            Primary
        </ol-button>
        <ol-button variant="destructive">
            Destructive
        </ol-button>
    {% endcall %}
    {% call ex.example("Sizes", "Heights come from the shared --control-height-* tokens, so each size lines up with the same-size segmented control and input.") %}
        <ol-button size="small">
            Small
        </ol-button>
        <ol-button>
            Medium
        </ol-button>
        <ol-button size="large">
            Large
        </ol-button>
    {% endcall %}
    {% call ex.example("With icon", "The default slot takes any markup, so an inline SVG before the label renders as a leading icon. Give it a fixed size and a small inline-end margin.",
        code='<ol-button size="small">\n  <svg width="14" height="14" ...></svg>Preview\n</ol-button>') %}
        <ol-button size="small">
            <svg width="14"
                 height="14"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true"
                 class="ds-demo-btn-icon">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            Preview
        </ol-button>
        <ol-button size="small">
            <svg width="14"
                 height="14"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true"
                 class="ds-demo-btn-icon">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
            </svg>
            Search Inside
        </ol-button>
    {% endcall %}
    {% call ex.example("Disabled") %}
        <ol-button disabled>
            Secondary
        </ol-button>
        <ol-button variant="primary" disabled>
            Primary
        </ol-button>
        <ol-button variant="destructive" disabled>
            Destructive
        </ol-button>
    {% endcall %}
    {% call ex.example("Loading", "Shows a spinner and blocks interaction. The label stays in the DOM so the button's width doesn't shift.") %}
        <ol-button variant="primary" loading>
            Save
        </ol-button>
        <ol-button loading>
            Cancel
        </ol-button>
        <ol-button variant="destructive" loading>
            Delete
        </ol-button>
    {% endcall %}
    {% call ex.example("Loading, driven from JS", "Click for a 1.5s fake request. Setting .loading disables the button for the duration.",
        code="button.loading = true;\nawait save();\nbutton.loading = false;") %}
        <ol-button id="demo-button-loading">
            Save
        </ol-button>
        <script>
            document.getElementById('demo-button-loading').addEventListener('click', function (e) {
                const button = e.currentTarget;
                if (button.loading) return;
                button.loading = true;
                setTimeout(function () { button.loading = false; }, 1500);
            });
        </script>
    {% endcall %}
    {% call ex.example("Full width") %}
        <ol-button full-width>
            Continue
        </ol-button>
    {% endcall %}
    {% call ex.example("Form submission", "The component renders a real <button type=\"submit\">, so native validation, the form's submit event, and Enter-to-submit all work with no extra wiring.") %}
        <form id="demo-button-form" class="ds-demo-row">
            <label for="demo-button-form-input">Your name:</label>
            <input id="demo-button-form-input" name="name" required>
            <ol-button type="submit">
                Submit
            </ol-button>
            <ol-button type="reset" variant="secondary">
                Reset
            </ol-button>
        </form>
        <p>Last submitted: <strong id="demo-button-form-output">—</strong></p>
        <script>
            (function () {
                const form = document.getElementById('demo-button-form');
                const out = document.getElementById('demo-button-form-output');
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    out.textContent = new FormData(form).get('name') || '—';
                });
                form.addEventListener('reset', function () { out.textContent = '—'; });
            })();
        </script>
    {% endcall %}
    <div class="ds-notes">
        <p>
            <b>Events.</b> None custom — use the native <code>click</code>, which bubbles from the inner <code>&lt;button&gt;</code>.
        </p>
        <p>
            <b>Rendering.</b> Light DOM, no shadow root. Styles live in <code>components/ol-button.css</code>, loaded render-blocking by every page entry point that uses the button. Before upgrade the host is styled by attribute selectors so it's visible immediately; after upgrade the component inserts a real <code>&lt;button&gt;</code> child and the host collapses to a transparent wrapper.
        </p>
    </div>
{% endmacro %}
