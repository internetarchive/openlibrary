{% import "design/_example.html.jinja" as ex %}
{% macro demos() %}
    {% call ex.example("Default", "Hover or focus the trigger. Placement is top with a 150ms show delay.", output_style="display: flex; gap: 24px; align-items: center;") %}
        <ol-tooltip content="Edit this item">
            <button class="demo-btn">Edit</button>
        </ol-tooltip>
        <ol-tooltip content="Delete permanently">
            <button class="demo-btn">Delete</button>
        </ol-tooltip>
        <ol-tooltip content="Share with others">
            <button class="demo-btn">Share</button>
        </ol-tooltip>
    {% endcall %}
    {% call ex.example("Placement", "Flips automatically near viewport edges. Add arrow to show the directional arrow, hidden by default.", output_style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;") %}
        <ol-tooltip content="I'm on top" placement="top" arrow>
            <button class="demo-btn">top</button>
        </ol-tooltip>
        <ol-tooltip content="I'm on the bottom" placement="bottom" arrow>
            <button class="demo-btn">bottom</button>
        </ol-tooltip>
        <ol-tooltip content="I'm on the left" placement="left" arrow>
            <button class="demo-btn">left</button>
        </ol-tooltip>
        <ol-tooltip content="I'm on the right" placement="right" arrow>
            <button class="demo-btn">right</button>
        </ol-tooltip>
    {% endcall %}
    {% call ex.example("Rich content via slot", "Use slot=\"content\" for HTML inside the tooltip.") %}
        <ol-tooltip>
            <button class="demo-btn">Info</button>
            <span slot="content">Keyboard shortcut: <strong>Ctrl+K</strong></span>
        </ol-tooltip>
    {% endcall %}
    {% call ex.example("Book hovercard", "Slotted content lives in the light DOM, so page CSS styles it. Inherited properties like color cascade in from the tooltip; structural styles come from the consuming page's stylesheet.",
        code='<ol-tooltip placement="bottom" arrow>\n  <img class="book-tip__trigger"
        width="120"
        height="180"
        src="…"
        alt="Cover">\n  <div slot="content" class="book-tip">…</div>\n</ol-tooltip>',
        output_style="display: flex; gap: 12px; align-items: flex-end;") %}
        <ol-tooltip placement="bottom" arrow>
            <img class="book-tip__trigger"
                 width="120"
                 height="180"
                 tabindex="0"
                 src="//covers.openlibrary.org/b/id/11720583-M.jpg"
                 alt="Statistical methods for planners">
            <div slot="content" class="book-tip">
                <div class="book-tip__heading">
                    <span class="book-tip__title">Statistical methods for planners</span>
                    <span class="book-tip__year">(1980)</span>
                </div>
                <div class="book-tip__byline">By Thomas R. Willemain</div>
            </div>
        </ol-tooltip>
        <ol-tooltip placement="bottom" arrow>
            <img class="book-tip__trigger"
                 width="120"
                 height="180"
                 tabindex="0"
                 src="//covers.openlibrary.org/b/id/15144117-M.jpg"
                 alt="Prescott's Microbiology">
            <div slot="content" class="book-tip">
                <div class="book-tip__heading">
                    <span class="book-tip__title">Prescott's Microbiology</span>
                    <span class="book-tip__year">(2013)</span>
                </div>
                <div class="book-tip__byline">By Joanne Willey, Linda Sherwood, and Chris Woolverton</div>
            </div>
        </ol-tooltip>
        <ol-tooltip placement="bottom" arrow>
            <img class="book-tip__trigger"
                 width="120"
                 height="180"
                 tabindex="0"
                 src="//covers.openlibrary.org/b/id/14918485-M.jpg"
                 alt="Encyclopaedia of hand-weaving">
            <div slot="content" class="book-tip">
                <div class="book-tip__heading">
                    <span class="book-tip__title">Encyclopaedia of hand-weaving</span>
                    <span class="book-tip__year">(1959)</span>
                </div>
                <div class="book-tip__byline">By Stanislaw Adam Zielinski</div>
            </div>
        </ol-tooltip>
    {% endcall %}
{% endmacro %}
