{% import "design/_example.html.jinja" as ex %}
{% macro cards(count) %}
    {% for i in range(1, count + 1) %}<div class="design-carousel-demo-card">{{ i }}</div>{% endfor %}
{% endmacro %}
{% macro shelf_menu() %}
    <ul class="ds-demo-menu">
        <li>Want to Read</li>
        <li>Currently Reading</li>
        <li>Already Read</li>
        <li class="ds-demo-menu__divided">Add to a list</li>
    </ul>
{% endmacro %}
{% macro demos() %}
    <p class="ds-lead">
        A paged, Netflix-style horizontal carousel. Items are direct children; the component sets their width from responsive breakpoints and provides arrow buttons, edge peek, and bar-segment page indicators. The viewport is a native scroll container with CSS scroll snapping, so swipe momentum, overscroll, and trackpad and wheel scrolling all behave exactly as the operating system does elsewhere.
    </p>
    {% call ex.example("Basic usage", "Pass each item as a direct child. Set an accessible label for the carousel region.",
        code='<ol-carousel label="Trending">\n  <div>...item...</div>\n  <div>...item...</div>\n</ol-carousel>') %}
        <ol-carousel label="Trending">
            {{ cards(15) }}
        </ol-carousel>
    {% endcall %}
    {% call ex.example("Book covers with actions", "Items compose with other components: hovering or focusing a cover shows an ol-tooltip, and the ol-button under each cover opens an ol-popover menu. Both render in the top layer, so the carousel viewport never clips them. --ol-carousel-viewport-padding leaves room for the cover hover ring.",
        code='<ol-carousel label="Classic books" style="--ol-carousel-viewport-padding: 8px;">\n  <div class="book-card">\n    <ol-tooltip content="The Great Gatsby (1925) · F. Scott Fitzgerald">\n      <img src="//covers.openlibrary.org/b/id/10590366-M.jpg"
        alt="The Great Gatsby"
        loading="lazy"
        tabindex="0">\n    </ol-tooltip>\n    <ol-popover aria-label="Shelve The Great Gatsby">\n      <ol-button slot="trigger" size="small" full-width>Want to read</ol-button>\n      <ul>...shelf options...</ul>\n    </ol-popover>\n  </div>\n  ...more books...\n</ol-carousel>') %}
        {% set books = [('10590366', 'The Great Gatsby', 'F. Scott Fitzgerald', 1925), ('14348537', 'Pride and Prejudice', 'Jane Austen', 1813), ('10544254', 'Moby Dick', 'Herman Melville', 1851), ('8235363', 'Jane Eyre', 'Charlotte Brontë', 1847), ('12356249', 'Frankenstein', 'Mary Shelley', 1818), ('12216503', 'Dracula', 'Bram Stoker', 1897), ('14627509', 'The Hobbit', 'J.R.R. Tolkien', 1937), ('12818862', 'Wuthering Heights', 'Emily Brontë', 1847), ('8238803', 'Mythos', 'Stephen Fry', 2017), ('8765912', 'Mythology', 'Edith Hamilton', 1942), ('7996608', 'Where the Red Fern Grows', 'Wilson Rawls', 1961), ('12474938', 'The Odyssey', 'Homer', 1946)] %}
        <ol-carousel label="Classic books" style="--ol-carousel-viewport-padding: 8px;">
            {% for cover_id, title, author, year in books %}
                <div class="design-carousel-book">
                    <ol-tooltip content="{{ title }} ({{ year }}) · {{ author }}">
                        <img class="design-carousel-book__cover"
                             width="180"
                             height="270"
                             loading="lazy"
                             tabindex="0"
                             src="//covers.openlibrary.org/b/id/{{ cover_id }}-M.jpg"
                             alt="{{ title }}">
                    </ol-tooltip>
                    <ol-popover aria-label="Shelve {{ title }}">
                        <ol-button slot="trigger" size="small" full-width>
                            Want to read
                        </ol-button>
                        {{ shelf_menu() }}
                    </ol-popover>
                </div>
            {% endfor %}
        </ol-carousel>
    {% endcall %}
    {% call ex.example("Page indicators", "Hidden by default; show-indicators displays the page indicator bar.",
        code='<ol-carousel label="New releases" show-indicators>\n  ...items...\n</ol-carousel>') %}
        <ol-carousel label="New releases" show-indicators>
            {{ cards(12) }}
        </ol-carousel>
    {% endcall %}
    {% call ex.example("Page-change event", "Fires ol-carousel-page-change after each transition, with { page, previousPage, totalPages } in event.detail — previousPage lets a consumer infer direction without keeping state.",
        code='<ol-carousel id="demo-carousel" label="Popular">\n  ...items...\n</ol-carousel>\n\n<script>\n  carousel.addEventListener(\'ol-carousel-page-change\', (e) => {\n    console.log(e.detail.page, e.detail.totalPages);\n  });\n</script>') %}
        <ol-carousel id="demo-carousel" label="Popular">
            {{ cards(18) }}
        </ol-carousel>
        <p>Page <strong id="demo-carousel-page">1</strong> of <strong id="demo-carousel-total">?</strong></p>
        <script>
            (() => {
                const carousel = document.getElementById('demo-carousel');
                const setLabel = () => {
                    document.getElementById('demo-carousel-page').textContent = carousel.page + 1;
                    document.getElementById('demo-carousel-total').textContent = carousel.totalPages;
                };
                // Seed once the component has upgraded and measured its width.
                customElements.whenDefined('ol-carousel').then(() => carousel.updateComplete.then(setLabel));
                carousel.addEventListener('ol-carousel-page-change', setLabel);
            })();
        </script>
{% endcall %}
{% call ex.example("Load more", "Fires ol-carousel-near-end when the rail settles within two pages of the end — once per item count, so appending items re-arms it and a consumer with nothing left to add is not asked again. Here each event appends a batch, up to three.",
    code='<ol-carousel id="demo-load-more" label="Endless shelf" show-indicators>\n  ...items...\n</ol-carousel>\n\n<script>\n  carousel.addEventListener(\'ol-carousel-near-end\', async (e) => {\n    const cards = await fetchMoreCards(e.detail.itemCount);\n    cards.forEach((card) => carousel.appendChild(card));\n  });\n</script>') %}
    <ol-carousel id="demo-load-more" label="Endless shelf" show-indicators>
        {{ cards(18) }}
    </ol-carousel>
    <p>Batches loaded: <strong id="demo-load-more-batches">0</strong> of 3 · Items: <strong id="demo-load-more-count">18</strong></p>
    <script>
            (() => {
                const carousel = document.getElementById('demo-load-more');
                let batches = 0;
                carousel.addEventListener('ol-carousel-near-end', (e) => {
                    if (batches >= 3) return;   // pretend the result set is exhausted
                    batches += 1;
                    for (let i = 1; i <= 9; i++) {
                        const card = document.createElement('div');
                        card.className = 'design-carousel-demo-card';
                        card.textContent = e.detail.itemCount + i;
                        carousel.appendChild(card);
                    }
                    document.getElementById('demo-load-more-batches').textContent = batches;
                    document.getElementById('demo-load-more-count').textContent = carousel.children.length;
                });
            })();
    </script>
{% endcall %}
<div class="ds-notes">
    <p>
        <b>Paging.</b> Page boundaries are hard stops (<code>scroll-snap-stop: always</code>): a hard swipe or fling advances one page at a time instead of flying past several, matching the arrows and the one-page mouse flick.
    </p>
    <p>
        <b>Images.</b> Give every image its real URL in <code>src</code> and mark it <code>loading="lazy"</code>. The viewport is a scroll container, so it clips its overflow and the browser never fetches an off-page cover until you scroll toward it. Don't ship a placeholder <code>src</code> with the real URL parked in a data attribute — that convention predates <code>loading</code>, needs JS to undo, and leaves the browser deferring a placeholder that is already inline.
    </p>
    <p>
        <b>Labels.</b> Every string the component renders is an attribute with an English default — <code>label</code>, <code>label-previous</code>, <code>label-next</code>, <code>label-pages</code>, <code>label-go-to-page</code>. Pass translated values in from the template; <code>label-go-to-page</code> takes <code>{page}</code> and <code>{total}</code> placeholders so a translation can reorder them.
    </p>
</div>
{% endmacro %}
