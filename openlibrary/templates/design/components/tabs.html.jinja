{% import "design/_example.html.jinja" as ex %}
{% macro demos() %}
    <p class="ds-lead">
        Tabs are <code>&lt;ol-tab&gt;</code> children with a <code>value</code>; their text is the label. The component renders an ARIA tab list with one tab stop, and arrow keys move the selection. The page owns the content under the tabs: listen for <code>ol-tabs-change</code> and swap it.
    </p>
    {% call ex.example("Default", "The selected tab goes bold over an underline on the row's divider. Narrow screens scroll the row sideways instead of wrapping it.") %}
        <ol-tabs value="all" accessible-label="Sci-Fi subgenres">
            <ol-tab value="all">
                All Sci-Fi
            </ol-tab>
            <ol-tab value="space-opera">
                Space Opera
            </ol-tab>
            <ol-tab value="dystopian">
                Dystopian
            </ol-tab>
            <ol-tab value="steampunk">
                Steampunk
            </ol-tab>
        </ol-tabs>
    {% endcall %}
    {% call ex.example("Change event", "Selecting a tab fires ol-tabs-change with the new value in event.detail.value.") %}
        <ol-tabs id="demo-tabs" value="books" accessible-label="Search scope">
            <ol-tab value="books">
                Books
            </ol-tab>
            <ol-tab value="inside">
                Inside books
            </ol-tab>
        </ol-tabs>
        <p>Selected: <strong id="demo-tabs-value">books</strong></p>
        <script>
            document.getElementById('demo-tabs').addEventListener('ol-tabs-change', (e) => {
                document.getElementById('demo-tabs-value').textContent = e.detail.value;
            });
        </script>
    {% endcall %}
{% endmacro %}
