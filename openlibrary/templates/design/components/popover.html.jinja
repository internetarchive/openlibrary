{% import "design/_example.html.jinja" as ex %}
{% macro menu(min_width="180px") %}
    <ul class="ds-demo-menu" style="min-width: {{ min_width }};">
        <li>Edit</li>
        <li>Duplicate</li>
        <li class="ds-demo-menu__divided">Archive</li>
        <li>Move</li>
        <li>Share</li>
        <li class="ds-demo-menu__divided">Delete</li>
    </ul>
{% endmacro %}
{% macro demos() %}
    {% call ex.example("Menu popover", "Popovers animate from the trigger using transform-origin. Click to see the scale + fade entrance.",
        code='<ol-popover>\n  <ol-button slot="trigger">Options</ol-button>\n  <ul>...</ul>\n</ol-popover>') %}
        <ol-popover aria-label="Options menu">
            <ol-button slot="trigger">
                Options
            </ol-button>
            {{ menu() }}
        </ol-popover>
    {% endcall %}
    {% call ex.example("Placement", "transform-origin follows placement, so the animation always expands from the trigger.", output_style="display: flex; gap: 16px; flex-wrap: wrap;") %}
        <ol-popover placement="bottom-start" aria-label="Actions">
            <ol-button slot="trigger">
                bottom-start
            </ol-button>
            {{ menu("160px") }}
        </ol-popover>
        <ol-popover placement="top-center" aria-label="Actions">
            <ol-button slot="trigger">
                top-center
            </ol-button>
            {{ menu("160px") }}
        </ol-popover>
    {% endcall %}
    {% call ex.example("Block outside clicks", "By default the click that dismisses a popover also lands on whatever is underneath. With block-outside-clicks a transparent backdrop swallows it, so opening over dense links is safe. Try closing each popover by clicking a link beside it.",
        code='<ol-popover block-outside-clicks>\n  <ol-button slot="trigger">Options</ol-button>\n  <ul>...</ul>\n</ol-popover>', output_style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;") %}
        <ol-popover aria-label="Options menu">
            <ol-button slot="trigger">
                Default
            </ol-button>
            {{ menu("160px") }}
        </ol-popover>
        <ol-popover block-outside-clicks aria-label="Options menu">
            <ol-button slot="trigger">
                Blocked
            </ol-button>
            {{ menu("160px") }}
        </ol-popover>
        <a href="#popover-block-outside-clicks-clicked"
           onclick="this.textContent = 'Link was clicked'; return false;">A link the dismissing click could hit</a>
    {% endcall %}
{% endmacro %}
