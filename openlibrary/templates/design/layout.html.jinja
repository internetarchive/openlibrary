{#
  Shell for /developers/design. Renders the section tabs and the derived
  sidebar, then hands off to the section template — which supplies a `nav()`
  macro for the sidebar and a `body()` macro for the content.

  `ds` is the CSS/JS namespace for the whole design system docs area.
#}
{% import "design/" + section.id + ".html.jinja" as page with context %}
<div class="ds" data-ds-root>
    <header class="ds__masthead">
        <div class="ds__masthead-row">
            <h1 class="ds__title">Design system</h1>
            <nav class="ds__tabs" aria-label="Design system sections">
                {% for candidate in sections %}
                    <a class="ds__tab{% if candidate.id == section.id %} ds__tab--current{% endif %}"
                       href="/developers/design/{{ candidate.id }}"
                       {% if candidate.id == section.id %}aria-current="page"{% endif %}>{{ candidate.title }}</a>
                {% endfor %}
            </nav>
        </div>
    </header>
    <div class="ds__layout">
        <nav class="ds__sidebar" aria-label="{{ section.title }} contents">
            {{ page.nav() }}
            {% if section.has_code %}
                {# Dogfooding: the page's own control is the component it documents. #}
                <div class="ds__sidebar-controls">
                    <ol-toggle data-ds-code-toggle label="Show code">
                    </ol-toggle>
                </div>
            {% endif %}
        </nav>
        <main class="ds__main">
            {{ page.body() }}
        </main>
    </div>
</div>
