{#
  Playground — cross-component checks that are easier to eyeball than to
  unit-test. These are QA surfaces: they exist to make drift visible, not to
  document any single component. Each check puts one of everything side by
  side so a height, a hover, a selected fill, or a focus ring that disagrees
  with its neighbours reads as wrong at a glance.
#}
{% import "design/components/popover.html.jinja" as pop with context %}
{% set CHECKS = [('control-alignment', 'Control alignment'), ('control-states', 'Control states'), ('selected-look', 'Selected look'), ('menus', 'Menus and panels'), ('surfaces', 'Surfaces and text'), ('focus', 'Focus rings'), ('density', 'Density'), ('long-content', 'Long content'), ('rtl', 'Right-to-left')] %}
{% set SELECT_ITEMS = "[{\"value\":\"en\",\"label\":\"English\"},{\"value\":\"es\",\"label\":\"Spanish\"},{\"value\":\"fr\",\"label\":\"French\"}]" %}
{% set MENU_ITEMS = "[{\"value\":\"relevance\",\"label\":\"Relevance\"},{\"value\":\"new\",\"label\":\"Most Recent\"},{\"value\":\"rating\",\"label\":\"Top Rated\"}]" %}
{% set OPTIONS_ITEMS = "[{\"value\":\"fiction\",\"label\":\"Fiction\",\"description\":\"Novels and short stories\",\"count\":\"1,024\"},{\"value\":\"nonfiction\",\"label\":\"Nonfiction\",\"description\":\"Fact-based works and essays\",\"count\":\"892\"},{\"value\":\"poetry\",\"label\":\"Poetry\",\"count\":\"213\"}]" %}
{% set MANY_LANGUAGES = "[{\"value\":\"en\",\"label\":\"English\"},{\"value\":\"es\",\"label\":\"Spanish\"},{\"value\":\"fr\",\"label\":\"French\"},{\"value\":\"de\",\"label\":\"German\"},{\"value\":\"it\",\"label\":\"Italian\"},{\"value\":\"pt\",\"label\":\"Portuguese\"},{\"value\":\"zh\",\"label\":\"Chinese\"},{\"value\":\"ja\",\"label\":\"Japanese\"},{\"value\":\"ru\",\"label\":\"Russian\"},{\"value\":\"ar\",\"label\":\"Arabic\"}]" %}
{% set RTL_SELECT_ITEMS = "[{\"value\":\"ar\",\"label\":\"العربية\"},{\"value\":\"he\",\"label\":\"עברית\"},{\"value\":\"fa\",\"label\":\"فارسی\"},{\"value\":\"ur\",\"label\":\"اردو\"}]" %}
{#
  The surfaces a control can land on, for the Surfaces check and the state
  grid's surface switcher. `inverse` is text-only: no control is specified for
  a dark surface yet, which is itself one of the things the check shows.
#}
{% set SURFACES = [('--color-surface', 'Surface', 'Cards, inputs, dropdowns. Where almost every control is designed.'), ('--color-background', 'Background', 'The page canvas. Controls land here on the home page and search results.'), ('--color-surface-sunken', 'Sunken', 'Recessed panels and image wells.'), ('--color-surface-header', 'Header', 'The site header, the drawer panel, table heads.'), ('--color-control-bg', 'Control fill', 'The resting fill of a raised neutral control. A card that uses it as a background makes the button on it disappear.'), ('--color-primary-subtle', 'Primary subtle', 'Soft blue wash — info banners, the selected-tint family.'), ('--color-control-selected-surface', 'Selected surface', 'The opaque twin of the selected tint.'), ('--color-info-bg', 'Info', 'Status wash — messages and banners.'), ('--color-success-bg', 'Success', 'Status wash.'), ('--color-warning-bg', 'Warning', 'Status wash.'), ('--color-error-bg', 'Error', 'Status wash.')] %}
{% set TEXT_TOKENS = [('--color-text', 'Text'), ('--color-text-secondary', 'Secondary'), ('--color-text-muted', 'Muted'), ('--color-link', 'Link'), ('--color-icon-muted', 'Icon muted')] %}
{% set SELECTED_TOKENS = [('--color-control-selected-bg', 'Selected tint', 'Button, toggle button, pagination, editor toolbar', '--color-link'), ('--color-control-selected-border', 'Selected border', 'Button and toggle button; pagination omits it', '--color-link'), ('--color-primary-subtle', 'Primary subtle', 'Info banner wash', '--color-link'), ('--color-info-bg', 'Info bg', 'Message wash; one step off primary-subtle', '--color-link'), ('--color-control-track', 'Segmented track', 'The pill sits proud of it in ink, not blue', '--color-text'), ('--color-primary', 'Primary', 'Primary button, selected chip, switch track, radio accent', '--color-on-primary'), ('--color-link', 'Link', 'Selected label text; menu current row', '--color-on-primary'), ('--color-focus-ring', 'Focus ring', 'Every focus ring', '--color-on-primary')] %}
{% macro nav() %}
    <ul class="ds__nav-list">
        {% for id, title in CHECKS %}<li><a href="#{{ id }}">{{ title }}</a></li>{% endfor %}
    </ul>
{% endmacro %}
{#
  A labelled specimen: one control on a stage with a caption naming what to
  look at. The strips below are rows of these, so a row reads as "one of
  everything" with the differences spelled out underneath.
#}
{% macro specimen(caption, note="") %}
    <figure class="ds-specimen">
        <div class="ds-specimen__stage">{{ caller() }}</div>
        <figcaption class="ds-specimen__caption">
            {{ caption }}
            {% if note %}<span class="ds-specimen__note">{{ note }}</span>{% endif %}
        </figcaption>
    </figure>
{% endmacro %}
{#
  One row of every height-locked control at a given size, plus the chip,
  which sizes from its content and *should* still land on the line. The
  dashed guides in .control-row sit at exactly the target token height, so a
  control that over- or undershoots reads as misaligned at a glance. A row
  with a chevron (the menu triggers) checks that the disclosure affordance
  doesn't grow the button. The medium row also carries the controls that only
  come in one size: the toggle button, both shelf buttons, and tabs.
#}
{% macro control_row(size) %}
    {% set size_attr = ('size="' ~ size ~ '"') | safe if size != "medium" else "" %}
    <div class="ds-example__output control-row control-row--{{ size }}">
        <span class="control-row__cell">
            <ol-button {{ size_attr }} variant="secondary">
                Button
            </ol-button>
        </span>
        <span class="control-row__cell">
            <ol-button {{ size_attr }} variant="primary">
                Primary
            </ol-button>
        </span>
        <span class="control-row__cell">
            <ol-button {{ size_attr }} variant="ghost">
                Ghost
            </ol-button>
        </span>
        <span class="control-row__cell">
            <ol-button {{ size_attr }} shape="icon" aria-label="Search, {{ size }}">
                <ol-icon name="search" size="sm">
                </ol-icon>
            </ol-button>
        </span>
        <span class="control-row__cell">
            <ol-segmented-control {{ size_attr }} accessible-label="Alignment, {{ size }}">
                <ol-segment value="grid">
                    Grid
                </ol-segment>
                <ol-segment value="list">
                    List
                </ol-segment>
            </ol-segmented-control>
        </span>
        <span class="control-row__cell">
            <ol-menu-popover label="Sort by" value="relevance" aria-label="Alignment menu, {{ size }}" items='{{ MENU_ITEMS }}'>
                <ol-button slot="trigger" {{ size_attr }}>
                    Sort by
                </ol-button>
            </ol-menu-popover>
        </span>
        <span class="control-row__cell">
            <ol-select-popover label="Language" search-threshold="999" aria-label="Alignment select, {{ size }}" items='{{ SELECT_ITEMS }}'>
                <ol-button slot="trigger" {{ size_attr }} variant="secondary">
                    Language
                </ol-button>
            </ol-select-popover>
        </span>
        {% if size in ("small", "medium") %}
            <span class="control-row__cell">
                <ol-pagination {{ size_attr }} total-pages="5" current-page="3" label-pagination="Alignment pagination, {{ size }}">
                </ol-pagination>
            </span>
            <span class="control-row__cell">
                <ol-chip {{ size_attr }}>
                    Chip
                </ol-chip>
            </span>
        {% endif %}
        {% if size == "medium" %}
            <span class="control-row__cell">
                <ol-toggle variant="button" label="Readable Only" sublabel="4.6M">
                </ol-toggle>
            </span>
            <span class="control-row__cell">
                <ol-shelf-button user-key="{{ user_key }}" work-key="/works/OL69612W" book-title="The Secret Garden">
                </ol-shelf-button>
            </span>
            <span class="control-row__cell">
                <ol-shelf-button variant="outline" user-key="{{ user_key }}" work-key="/works/OL69612W" book-title="The Secret Garden">
                </ol-shelf-button>
            </span>
            <span class="control-row__cell">
                <ol-tabs accessible-label="Alignment tabs">
                    <a slot="tab" href="#align-tab-a">Tab</a>
                    <a slot="tab" href="#align-tab-b">Tab</a>
                    <div id="align-tab-a"></div>
                    <div id="align-tab-b"></div>
                </ol-tabs>
            </span>
        {% endif %}
        <span class="control-row__cell">
            <input class="control-row__field"
                   type="text"
                   value="Input"
                   aria-label="Alignment input, {{ size }}">
        </span>
        <span class="control-row__cell">
            <select class="control-row__field"
                    aria-label="Alignment native select, {{ size }}">
                <option>Select</option>
                <option>Other</option>
            </select>
        </span>
    </div>
{% endmacro %}
{#
  The two controls that sit beside the medium row in real toolbars and are
  deliberately not locked to it. Same guides, so each one's offset is visible.
#}
{% macro neighbour_row() %}
    <div class="ds-example__output control-row control-row--medium">
        <span class="control-row__cell">
            <ol-toggle label="Switch">
            </ol-toggle>
        </span>
        <span class="control-row__cell">
            <nav class="ds-demo-menu control-row__menu" aria-label="Menu row sample">
                <a class="ds-demo-menu__link" href="#control-alignment">Menu row</a>
            </nav>
        </span>
    </div>
{% endmacro %}
{#
  The one-of-everything strip the state grid, hover check and focus check all
  start from. Each specimen names the mechanism its hover uses, so a sweep
  along the row compares them with the words right there.
#}
{% macro hover_strip() %}
    <div class="ds-strip">
        {% call specimen("Secondary", "fill + border step") %}
            <ol-button>
                Secondary
            </ol-button>
        {% endcall %}
        {% call specimen("Ghost", "fill only") %}
            <ol-button variant="ghost">
                Ghost
            </ol-button>
        {% endcall %}
        {% call specimen("Primary", "brightness 1.1") %}
            <ol-button variant="primary">
                Primary
            </ol-button>
        {% endcall %}
        {% call specimen("Icon button", "fill + border step") %}
            <ol-button shape="icon" aria-label="Search">
                <ol-icon name="search" size="sm">
                </ol-icon>
            </ol-button>
        {% endcall %}
        {% call specimen("Toggle button", "fill + border, highlight appears") %}
            <ol-toggle variant="button" label="Readable" sublabel="4.6M">
            </ol-toggle>
        {% endcall %}
        {% call specimen("Chip", "fill + mixed border") %}
            <ol-chip>
                Fiction
            </ol-chip>
        {% endcall %}
        {% call specimen("Chip, subject", "own -bg-hover") %}
            <ol-chip variant="subject">
                Science
            </ol-chip>
        {% endcall %}
        {% call specimen("Segmented", "text colour only") %}
            <ol-segmented-control accessible-label="Hover segmented">
                <ol-segment value="a">
                    One
                </ol-segment>
                <ol-segment value="b">
                    Two
                </ol-segment>
            </ol-segmented-control>
        {% endcall %}
        {% call specimen("Pagination", "hover overlay, no border") %}
            <ol-pagination total-pages="3" current-page="1" label-pagination="Hover pagination">
            </ol-pagination>
        {% endcall %}
        {% call specimen("Tabs", "text colour only") %}
            <ol-tabs accessible-label="Hover tabs">
                <a slot="tab" href="#hover-tab-a">One</a>
                <a slot="tab" href="#hover-tab-b">Two</a>
                <div id="hover-tab-a"></div>
                <div id="hover-tab-b"></div>
            </ol-tabs>
        {% endcall %}
        {% call specimen("Shelf button", "hover overlay, border static") %}
            <ol-shelf-button user-key="{{ user_key }}" work-key="/works/OL27448W" book-title="Pride and Prejudice">
            </ol-shelf-button>
        {% endcall %}
        {% call specimen("Menu row", "hover overlay pill") %}
            <nav class="ds-demo-menu ds-demo-menu--inline" aria-label="Hover menu row">
                <a class="ds-demo-menu__link" href="#control-states">Edit</a>
                <a class="ds-demo-menu__link" href="#control-states">History</a>
            </nav>
        {% endcall %}
    </div>
{% endmacro %}
{% macro body() %}
    <article class="ds-section control-alignment--guides-hidden"
             id="control-alignment">
        <h2 class="ds-section__title">Control alignment</h2>
        <p class="ds-section__blurb">
            Each height-locked control sets <code>height</code> (not vertical padding) from the same token with
            <code>box-sizing: border-box</code>, so they line up regardless of differing font sizes, borders,
            or content. The menu and select triggers are <code>ol-button</code>s, so they inherit the button's
            height for free; the chevron must not grow them. The chip is padding-driven and still has to
            land on the line. The medium row also carries the controls that come in one size only: the
            toggle button, the split shelf button (whose halves set <code>min-height</code> so a long shelf
            name can wrap — the host's border brings it to the token), the outline shelf square, and tabs.
            Toggle the guides and read each row against them.
        </p>
        <div class="control-alignment__guides-toggle">
            <ol-toggle id="control-alignment-guides" accessible-label="Show guide lines" label="Guide lines">
            </ol-toggle>
        </div>
        <h3 class="ds-group__title">Small — <code>--control-height-small</code></h3>
        {{ control_row("small") }}
        <h3 class="ds-group__title">Medium — <code>--control-height-medium</code></h3>
        {{ control_row("medium") }}
        <h3 class="ds-group__title">Large — <code>--control-height-large</code></h3>
        {{ control_row("large") }}
        <h3 class="ds-group__title">Medium neighbours — not height-locked</h3>
        <p class="ds-group__blurb">
            The two medium neighbours that are deliberately off the token. The switch is a
            checkbox-class control: it centres on its label's text line, not on a button box, so
            locking it would only wrap it in an invisible frame. The menu row is sized to be tapped,
            and drops to <code>--control-height-medium</code> only on hover-capable pointers.
        </p>
        {{ neighbour_row() }}
        <script>
            (function () {
                const article = document.getElementById('control-alignment');
                document.getElementById('control-alignment-guides').addEventListener('ol-toggle-change', (e) => {
                    article.classList.toggle('control-alignment--guides-hidden', !e.detail.checked);
                });
            })();
        </script>
    </article>
    <section class="ds-section" id="control-states">
