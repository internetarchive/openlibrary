        <h3 class="ds-group__title">Hover</h3>
        <p class="ds-group__blurb">
            Sweep the pointer along the row. Each caption names the mechanism the control uses, so a hover that
            looks different from its neighbour's can be matched to why. The rule is one mechanism per family:
            raised controls step fill and border together, flat rows take the translucent overlay, saturated
            fills brighten, and nothing fades in. Shelf button and pagination hover with the row overlay
            although they are controls; the segmented control and tabs move only their text.
        </p>
        <div class="ds-example__output ds-example__output--surface"
             data-surface-follows="control-states-grid">{{ hover_strip() }}</div>
        <script>
            (function () {
                const grid = document.getElementById('control-states-grid');
                const followers = document.querySelectorAll('[data-surface-follows="control-states-grid"]');
                document.getElementById('control-states-surface').addEventListener('ol-segmented-control-change', (e) => {
                    grid.dataset.surface = e.detail.value;
                    followers.forEach((el) => { el.dataset.surface = e.detail.value; });
                });
                document.getElementById('control-states-magnify').addEventListener('ol-toggle-change', (e) => {
                    grid.classList.toggle('ds-state-grid--magnified', e.detail.checked);
                });
            })();
        </script>
