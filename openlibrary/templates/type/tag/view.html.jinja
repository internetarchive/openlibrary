{# Takes `tag`, `title`, `description_html`, `body_html`, `subject_key`, `is_subject_tag`
   and the databar's `edit_url`, `history_url`, `show_edit`, `date` and `author_link`. #}
<div id="contentHead">
    {% include "databarView.html.jinja" %}
    <h1 itemprop="name">{{ title }}</h1>
    <div itemprop="tag-type">
        {{ _("<strong>Type:</strong> %(tag_type)s", tag_type=tag.tag_type) | safe }}
    </div>
    <div itemprop="description">
        <strong>{{ _("Description") }}</strong>
        {{ description_html }}
    </div>
    <div>
        <strong>{{ _("Tag Body") }}</strong>
        {{ body_html }}
    </div>
    {% if tag.get("slugs") %}
        <div>
            <strong>{{ _("URL Slugs") }}</strong>
            <span>{{ tag.slugs | join(", ") }}</span>
        </div>
    {% endif %}
    {% if is_subject_tag and subject_key %}
        <footer>
            <ol-chip-group gap="small">
                <ol-chip size="small" href="{{ subject_key }}">
                    {{ _("View subject page for %(name)s.", name=title) }}
                </ol-chip>
            </ol-chip-group>
        </footer>
    {% endif %}
</div>
