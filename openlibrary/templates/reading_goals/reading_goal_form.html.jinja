{% macro goal_form(goal=None, year=None, update=False) %}
    <form class="goal-form" action="/reading-goal.json" method="post">
        <input type="hidden" name="year" value="{{ year if year else '' }}">
        {% if update %}
            <input type="hidden" name="is_update" value="true">
        {% endif %}
        <div class="goal-form__question">
            <span id="yearly-goal-prompt">{{ _("How many books would you like to read this year?") }}</span>
            {% if not goal %}
                <a class="goal-form__learn-more"
                   href="https://blog.openlibrary.org/2022/12/31/reach-your-2023-reading-goals-with-open-library"
                   target="_blank"
                   rel="noopener noreferrer">{{ _("Learn More") }}</a>
            {% endif %}
        </div>
        {% if goal %}
            <div class="goal-form__note">{{ _("Enter \"0\" to unset your reading goal. Your check-ins will be preserved.") }}</div>
        {% endif %}
        <div class="goal-form__input-section">
            <input type="number"
                   name="goal"
                   min="{{ 0 if goal else 1 }}"
                   step="1"
                   value="{{ goal if goal else '' }}"
                   max="10000"
                   aria-labelledby="yearly-goal-prompt"
                   required>
            <button class="cta-btn cta-btn--shell reading-goal-submit-button"
                    type="submit"
                    data-ol-link-track="YearlyReadingGoals|SubmitGoal">{{ _("Submit") }}</button>
        </div>
    </form>
{% endmacro %}
