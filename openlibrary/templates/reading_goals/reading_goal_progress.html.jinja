{# Renders a collection of reading goals progress components.
   `goals` are YearlyGoal objects (year, goal, books_read, progress)
   from yearly_reading_goals.py — the template composes the
   nested macros, no HTML is passed down. #}
{% from "reading_goals/reading_goal_form.html.jinja" import goal_form %}
{% from "native_dialog.html.jinja" import dialog %}
<div class="reading-goal-progress-container" style="padding: 0;">
    {% for goal in goals %}
        <div class="reading-goal-progress" style="margin-bottom: 0;">
            <div class="reading-goal-progress__body">
                
                {% if show_header is not defined or show_header %}
                <div class="reading-goal-progress__header section-header">
                    <span class="reading-goal-progress__title">{{ _('Reading Goal') }}</span>
                    <a href="javascript:;" class="reading-goal-progress__edit" data-ol-link-track="ReadingGoalProgress|EditGoal" data-dialog-trigger="#yearly-goal-modal-{{ loop.index }}">{{ _('Edit') }}</a>
                </div>
                {% endif %}

                <div class="reading-goal-progress__progress-bar">
                    {% set completed = 100 if goal.progress > 100 else goal.progress %}
                    <span class="reading-goal-progress__completed" style="width: {{ completed }}%;"></span>
                    <div class="reading-goal-progress__progress-text">
                        <span class="reading-goal-progress__books-read">{{ goal.books_read }}</span>
                        <span class="reading-goal-progress__separator">/</span>
                        <span class="reading-goal-progress__goal">{{ goal.goal }} {{ _('books') }}</span>
                    </div>
                </div>

                <!-- Edit Goal Modal -->
                {% set reading_goal_form = goal_form(goal.goal, goal.year, true) %}
                {% set id = 'yearly-goal-modal-' ~ loop.index %}
                {% set title = _('Edit %(year)d Reading Goal', year=goal.year) %}
                {{ dialog(id=id, title=title, content=reading_goal_form) }}
                
            </div>
        </div>
    {% endfor %}
</div>