{# Renders a collection of reading goals progress components. #}
{# goals : list[YearlyGoal] : Chronological list of yearly goal objects #}
{# YearlyGoal.year : int : The year this goal was set #}
{# YearlyGoal.goal : int : The amount of books desired to be read #}
{# YearlyGoal.books_read : int : The amount of books finished this year #}
{# YearlyGoal.progress : int : Percent of goal achieved #}
{# render_jinja_template : callable : passed through so this template can render #}
{#   its nested reading_goal_form/native_dialog templates without a new global #}
<div class="reading-goal-progress-container">
    {% for goal in goals %}
        {% set completed = 100 if goal.progress > 100 else goal.progress %}
        <div class="reading-goal-progress">
            <div class="reading-goal-progress__body">
                <div class="reading-goal-progress__progress-bar">
                    <span class="reading-goal-progress__completed"
                          style="width: {{ completed }}%"></span>
                </div>
                <div class="reading-goal-progress__details">
                    <a href="/account/books/already-read/year/{{ goal.year }}"
                       data-ol-link-track="ReadingGoalProgress|AnnualSummaryLink">{{ _('<span class="reading-goal-progress__books-read">%(books_read)d</span>/<span class="reading-goal-progress__goal">%(goal)d</span> Books', books_read=goal.books_read, goal=goal.goal) | safe }}</a>
                    <a class="edit-reading-goal-link" href="javascript:;">{{ _("Edit") }}</a>
                </div>
                {% set reading_goal_form = render_jinja_template("reading_goals/reading_goal_form.html.jinja", goal=goal.goal, year=goal.year, update=true) %}
                {{ render_jinja_template("native_dialog.html.jinja", id="yearly-goal-modal-" ~ loop.index, content=reading_goal_form, title=_("Edit %(year)d Reading Goal", year=goal.year)) | safe }}
            </div>
        </div>
    {% endfor %}
</div>
