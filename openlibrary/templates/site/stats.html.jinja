<div class="hidden" id="debug-stats">
    <h2>{{ _("Debug Stats") }}</h2>
    <h3>{{ _("Summary") }}</h3>
    <pre>
{% set stats = stats_summary() %}
{% for k in stats %}
{{ k }}: {{ dict(stats[k]) }}
{% endfor %}
</pre>
    <h3>{{ _("Details") }}</h3>
    <pre>
{% for s in ctx.get("stats", []) %}
{{ s.name }} {{ s.time }}
    {{ s.data }}
{% endfor %}
</pre>
</div>
