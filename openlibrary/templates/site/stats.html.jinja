<div class="hidden" id="debug-stats">
    <h2>{{ _("Debug Stats") }}</h2>
    <h3>{{ _("Summary") }}</h3>
    <pre>
{% for k, v in layout.stats_summary.items() %}
{{ k }}: {{ v }}
{% endfor %}
</pre>
    <h3>{{ _("Details") }}</h3>
    <pre>
{% for s in layout.stats_details %}
{{ s.name }} {{ s.time }}
    {{ s.data }}
{% endfor %}
</pre>
</div>
