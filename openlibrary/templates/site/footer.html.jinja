{% set show_ol_shell = ctx.get('show_ol_shell', True) %}
<!--For analytics-->
{% set stats = stats_summary() %}
{% set raw_time = stats.get('total', {}).get('time') if stats else None %}
{% if raw_time is not none and raw_time != "" %}
    {% set total_time = (raw_time | float) * 1000 %}
{% else %}
    {% set total_time = 0 %}
{% endif %}
{% if show_ol_shell %}
    <div class="clearfix"></div>
{% endif %}
{% if query_param('debug') %}
    {% include "site/stats.html.jinja" %}
{% endif %}
{% if show_ol_shell %}
    {% include "lib/nav_foot.html.jinja" %}
{% endif %}
{% if not is_bot() %}
    <script src="/cdn/archive.org/athena.js" type="text/javascript"></script>
{% endif %}
<script src="{{ static_url('build/js/all.js') }}" type="text/javascript"></script>
<script src="{{ static_url('build/lit-components/production/ol-components.js') }}"
        type="module"></script>
<div class="analytics-stats-time-calculator" data-time="{{ total_time }}"></div>
</body>
</html>
