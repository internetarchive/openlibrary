{# id : str : Unique identifier for the dialog element #}
{# content : str : Rendered content to be displayed within the modal #}
{# title : str|None : Title of modal #}
{% set title = title | default(none) %}
<dialog{% if id %} id="{{ id }}"{% endif %} class="native-dialog">
    <div class="floaterHead">
        {% if title %}
            <h2>{{ title }}</h2>
        {% endif %}
        {# detect-missing-i18n-skip-line #}
        <a class="native-dialog--close" href="javascript:;">×<span class="shift">{{ _("Close") }}</span></a>
    </div>
    {{ content | safe }}
</dialog>
