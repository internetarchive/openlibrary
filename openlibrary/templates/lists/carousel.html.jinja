{# Book page "Lists" carousel. Rendered by BookPageListsPartial (plugins/openlibrary/partials.py). #}
{% from "lists/list_follow.html.jinja" import list_card %}
<div class="carousel-section">
    <div class="list-follow-showcase">
        {% for card in cards %}
            {{ list_card(card) }}
        {% endfor %}
        {% if has_more %}
            <a class="list-follow-showcase__see-all cta-btn cta-btn--vanilla"
               href="{{ all_url }}">{{ _("See all") }}</a>
        {% endif %}
    </div>
</div>
