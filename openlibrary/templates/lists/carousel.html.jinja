{# Book page "Lists" carousel. Rendered by BookPageListsPartial (plugins/openlibrary/partials.py). #}
{% from "lists/list_follow.html.jinja" import list_card %}
<div class="carousel-section">
    <ol-carousel class="carousel--native list-follow-showcase" label="{{ _('Lists') }}" label-previous="{{ _('Previous page') }}" label-next="{{ _('Next page') }}" label-pages="{{ _('Carousel pages') }}" label-go-to-page="{{ _('Go to page {page} of {total}') }}" label-page-announcement="{{ _('Page {page} of {total}') }}" breakpoints="[[480, 1], [768, 2], [1024, 3], [null, 4]]">
        {% for card in cards %}
            {{ list_card(card) }}
        {% endfor %}
    </ol-carousel>
    {% if has_more %}
        <a class="list-follow-showcase__see-all carousel-see-all"
           href="{{ all_url }}">{{ _("See all") }}{{ icon("chevron-right", size="sm") }}</a>
    {% endif %}
</div>
