{#
  Rendered by shelf_button_for() in plugins/upstream/mybooks.py, the one
  producer of this tag. `state` is one entry from get_reading_states();
  `hydrated` says the reader's state is on the button, so book-state.js
  does not fetch it again. An async_load button (carousels) comes without
  either; book-state.js fills them in.
  `lists_only` is a seed with no work to shelve: work_key is then the
  author's or edition's own key.
#}
{% set state = state or {} %}
<ol-shelf-button variant="{{ variant }}" work-key="{{ work_key }}" book-title="{{ title }}" {%- if hydrated %} data-hydrated{% endif %} {%- if lists_only %} lists-only{% endif %} {%- if edition_key %} edition-key="{{ edition_key.split('/')[-1] }}"{% endif %} {%- if user_key %} user-key="{{ user_key }}"{% endif %} {%- if state.get('shelf') is not none %} shelf="{{ state['shelf'] }}"{% endif %} {%- if state.get('rating') is not none %} rating="{{ state['rating'] }}"{% endif %} {%- if state.get('read_date') %} read-date="{{ state['read_date'] }}"{% endif %} {%- if state.get('event_id') is not none %} event-id="{{ state['event_id'] }}"{% endif %}>
</ol-shelf-button>
