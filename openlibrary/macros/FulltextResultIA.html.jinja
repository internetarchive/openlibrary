{# A hit with no OL edition renders from its IA metadata rather than vanishing (the total counts it). #}
{% set details_url = "https://archive.org/details/" ~ row.ocaid ~ "?" ~ ({"q": phrase} | urlencode) %}
<li class="searchResultItem sri--w-main">
    <div class="sri__main">
        <span class="bookcover">
            <a href="{{ details_url }}">
                <img src="https://archive.org/services/img/{{ row.ocaid }}"
                     alt="{{ _('Cover of: %(title)s', title=row.title) }}"
                     loading="lazy" />
            </a>
        </span>
        <div class="details">
            <div class="resultTitle">
                <h3 class="booktitle">
                    <a class="results" href="{{ details_url }}">{{ row.title }}</a>
                </h3>
            </div>
            {% if row.authors %}
                <span class="bookauthor">{{ _("by %(authors)s", authors=row.authors[:3] | join(", ")) }}</span>
            {% endif %}
            {% if row.year %}<span class="bookyear">{{ row.year }}</span>{% endif %}
        </div>
        {% include "FulltextSnippet.html.jinja" %}
    </div>
</li>
