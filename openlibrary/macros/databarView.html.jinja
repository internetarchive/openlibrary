{# Takes `edit_url`, `history_url`, `show_edit`, `date` and `author_link` (HTML, so it can hold a link). #}
<div id="editTools" class="edit">
    <div id="editInfo">
        <div class="brown smaller sansserif">
            {% if author_link %}
                {{ _("Last edited by %(author_link)s", author_link=author_link | safe) }}
            {% else %}
                {{ _("Last edited anonymously") }}
            {% endif %}
        </div>
        <div class="smallest gray sansserif">{{ date }} | <a href="{{ history_url }}"
    rel="nofollow"
    title="{{ _('View this template\'s edit history') }}">{{ _("History") }}</a></div>
    </div>
    {% if show_edit %}
        <div class="editButton">
            <a class="ol-button-static ol-button-static--small"
               href="{{ edit_url }}"
               title="{{ _('Edit this page') }}"
               data-ol-link-track="CTAClick|Edit"
               accesskey="e"
               rel="nofollow">{{ _("Edit") }}</a>
        </div>
    {% endif %}
</div>
