{#
   Testing Environment panel for /status, rendered by the Vue web component
   ol-testing-environment. The server supplies maintainer visibility, the
   Jenkins link, and translated strings because those are page configuration,
   not testing-environment state — the component fetches /status/testing.json
   and renders from that.

   The component fills the %(name)s placeholders, so each one is passed through
   as itself: Jinja's _() always %-formats. A plural set has the form for each
   CLDR plural category, from ngettext at a count in that category.
   #}
{% set i18n_strings = {
    "loading": _("Loading testing environment…"),
    "loadError": _("Could not load the testing environment."),
    "retry": _("Try again"),
    "actionFailed": _("Could not complete that action."),
    "addFailedNotFound": _("PR %(num)s does not exist.", num="%(num)s"),
    "addFailedUnavailable": _("Could not check PR %(num)s — GitHub is unavailable.", num="%(num)s"),
    "addFailedTokenInvalid": _("Could not add PR %(num)s — GitHub API token is invalid or expired. Check `github_api_token` in config/openlibrary.yml.", num="%(num)s"),
    "addFailedOther": _("Could not add PR %(num)s.", num="%(num)s"),
    "title": _("Testing Environment"),
    "addPrs": _("Add PRs"),
    "addPlaceholder": _("PR numbers or URLs, space or comma separated"),
    "add": _("Add PRs"),
    "addChange": _("Add"),
    "pr": _("PR"),
    "draft": _("Draft"),
    "author": _("Author"),
    "assignee": _("Assignee"),
    "drift": _("Drift"),
    "next": _("Next deploy"),
    "liveNow": _("Live now"),
    "notLive": _("Not yet deployed"),
    "mergeConflict": _("Deploy failed (merge conflict)"),
    "closed": _("This PR is already closed."),
    "actions": _("Actions"),
    "ok": _("OK"),
    "prOnTesting": _("PR %(num)s on testing", num="%(num)s"),
    "changeOnDeploy": _("changes on deploy"),
    "update": _("Update"),
    "updatePin": _("Update pin"),
    "enable": _("Enable"),
    "disable": _("Disable"),
    "remove": _("Remove"),
    "restore": _("Restore"),
    "refresh": _("Refresh from GitHub"),
    "deploy": _("Deploy"),
    "changes": {
        "one": ngettext("%(num)s change will be applied", "%(num)s changes will be applied", 1, num="%(num)s"),
        "two": ngettext("%(num)s change will be applied", "%(num)s changes will be applied", 2, num="%(num)s"),
        "few": ngettext("%(num)s change will be applied", "%(num)s changes will be applied", 3, num="%(num)s"),
        "many": ngettext("%(num)s change will be applied", "%(num)s changes will be applied", 11, num="%(num)s"),
        "other": ngettext("%(num)s change will be applied", "%(num)s changes will be applied", 100, num="%(num)s"),
    },
    "nothingToDeploy": _("Nothing to deploy — testing matches the current set."),
    "mergedToMaster": _("merged to master"),
    "closedWithoutMerging": _("closed without merging"),
    "unknown": _("Drift unknown, pinned at %(sha)s", sha="%(sha)s"),
    "currentCommit": _("Up-to-date, pinned at %(sha)s", sha="%(sha)s"),
    "behind": {
        "one": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 1, num="%(num)s", sha="%(sha)s"),
        "two": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 2, num="%(num)s", sha="%(sha)s"),
        "few": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 3, num="%(num)s", sha="%(sha)s"),
        "many": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 11, num="%(num)s", sha="%(sha)s"),
        "other": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 100, num="%(num)s", sha="%(sha)s"),
    },
    "neverDeployed": _("Never deployed"),
    "deployingStarted": _("Deploying, started %(time)s", time="%(time)s"),
    "deployingStartedBy": _("Deploying, started %(time)s by %(user)s", time="%(time)s", user="%(user)s"),
    "deployingStage": _("Deploying, started %(time)s — %(stage)s", time="%(time)s", stage="%(stage)s"),
    "deployingStageBy": _("Deploying, started %(time)s — %(stage)s by %(user)s", time="%(time)s", stage="%(stage)s", user="%(user)s"),
    "deploySucceeded": _("Deploy succeeded %(time)s", time="%(time)s"),
    "deploySucceededBy": _("Deploy succeeded %(time)s by %(user)s", time="%(time)s", user="%(user)s"),
    "deployFailed": _("Deploy failed %(time)s", time="%(time)s"),
    "deployFailedBy": _("Deploy failed %(time)s by %(user)s", time="%(time)s", user="%(user)s"),
    "deployFailedTrigger": _("Could not start the deploy — Jenkins did not accept the build."),
    "deployUnconfigured": _("Deploy is not configured on this instance — nothing was deployed."),
    "lastDeploy": _("Last deploy %(time)s", time="%(time)s"),
    "lastDeployBy": _("Last deploy %(time)s by %(user)s", time="%(time)s", user="%(user)s"),
    "viewJenkins": _("View Jenkins"),
    "noPrs": _("No PRs in testing set.")
} %}
{{ vue_component_html('TestingEnvironment', attrs={
    'maintainer': 'true' if is_maintainer else 'false',
    'jenkins-url': jenkins_job_url,
    'i18n': i18n_strings,
}) }}
