{#
   Client-rendering shell for the /status Testing Environment panel.

   The JavaScript controller fetches /status/testing.json and renders the panel
   from that response. The server still supplies maintainer visibility, the
   Jenkins link, and translated strings because those are page configuration,
   not testing-environment state.
   #}
{% set i18n_strings = {
    "loading": _("Loading testing environment…"),
    "loadError": _("Could not load the testing environment."),
    "retry": _("Try again"),
    "actionComplete": _("Action completed."),
    "actionFailed": _("Could not complete that action."),
    "deployTriggered": _("Deploy triggered!"),
    "deployFailed": _("Could not reach Jenkins — nothing was deployed. Your pending changes are still staged; try again."),
    "deployUnconfigured": _("No Jenkins token is configured, so no build was started. Pending changes were cleared locally."),
    "githubRefreshed": _("GitHub status refreshed."),
    "title": _("Testing Environment"),
    "addPrs": _("Add PRs"),
    "addPlaceholder": _("PR numbers or URLs, space or comma separated"),
    "add": _("Add PRs"),
    "addChange": _("Add"),
    "on": _("On"),
    "pr": _("PR"),
    "author": _("Author"),
    "assignee": _("Assignee"),
    "drift": _("Drift"),
    "actions": _("Actions"),
    "merged": _("merged"),
    "ok": _("OK"),
    "prOnTesting": _("PR %(num)s on testing", num="%s"),
    "changeOnDeploy": _("changes on deploy"),
    "removing": _("Removing #%(num)s…", num="%s"),
    "updating": _("Updating #%(num)s…", num="%s"),
    "enabling": _("Enabling #%(num)s…", num="%s"),
    "disabling": _("Disabling #%(num)s…", num="%s"),
    "deploying": _("Deploying to testing…"),
    "adding": _("Adding PRs…"),
    "update": _("Update"),
    "updatePin": _("Update pin"),
    "enable": _("Enable"),
    "disable": _("Disable"),
    "remove": _("Remove"),
    "refresh": _("Refresh from GitHub"),
    "deploy": _("Deploy"),
    "changeOne": _("%(num)s change will be applied", num="%s"),
    "changeMany": _("%(num)s changes will be applied", num="%s"),
    "nothingToDeploy": _("Nothing to deploy — testing matches the current set."),
    "mergedToMaster": _("merged to master"),
    "unknown": _("Drift unknown, pinned at %(sha)s", sha="%s"),
    "currentCommit": _("Up-to-date, pinned at %(sha)s", sha="%s"),
    "behindOne": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 1, num="%s", sha="%s"),
    "behindMany": ngettext("%(num)s commit behind %(sha)s", "%(num)s commits behind %(sha)s", 2, num="%s", sha="%s"),
    "neverDeployed": _("Never deployed"),
    "deployingStarted": _("Deploying, started %(time)s", time="%s"),
    "lastDeploy": _("Last deploy %(time)s", time="%s"),
    "viewJenkins": _("View Jenkins"),
    "noPrs": _("No PRs in testing set.")
} %}
<section class="testing-env"
         data-testing-env
         data-maintainer="{{ 'true' if is_maintainer else 'false' }}"
         data-jenkins-url="{{ jenkins_job_url }}"
         data-i18n='{{ i18n_strings | tojson }}'>
    <div class="testing-env__main">
        <p class="testing-env__blank"
           data-testing-loading
           role="status"
           aria-live="polite">{{ i18n_strings["loading"] }}</p>
    </div>
</section>
