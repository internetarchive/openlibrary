{# Shows a carousel placeholder: a skeleton of the row until lazy-carousel.js swaps the row in. #}
{% from "CarouselSkeleton.html.jinja" import carousel_skeleton %}
<div class="lazy-carousel" data-config="{{ lazy_config_json }}">
    {{ carousel_skeleton(layout=layout, title=title, title_link=title_link) }}
    <div class="lazy-carousel-retry hidden">
        {{ _("Failed to fetch carousel.") }} <a href="#" class="retry-btn">{{ _("Retry?") }}</a>
    </div>
    {% if fallback %}
        <div class="lazy-carousel-fallback hidden">
            {{ _("No books match the current filters.") }} <a href="#" class="retry-btn">{{ _("Retry without filters?") }}</a>
        </div>
    {% endif %}
</div>
