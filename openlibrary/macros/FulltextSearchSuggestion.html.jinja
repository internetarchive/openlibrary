
{% import "macros/FulltextSuggestionSnippet.html.jinja" as snippet %}
{% import "macros/FulltextSearchSuggestionItem.html.jinja" as item with context %}

{% if results and results.get('hits') %}
    {% set hits = results['hits'].get('hits', [])[:4] %}
    {% set num_found = commify(results['hits'].get('total', 0)) %}

    {{ render_templetor_template("LoadingIndicator", _("Checking for Search Inside matches")) }}
    <div id="fulltextSuggestions" class="fulltext-suggestions">
        <div class="fulltext-suggestions__header">
            {# The link is named by its icon; the heading beside it repeats the destination. #}
            <a class="fulltext-suggestions__icon"
               data-ol-link-track="SearchInsideSuggestion|SeeAllClick"
               href="/search/inside?{{ urlencode(dict(q=query)) }}">
                {{ icon("search-inside", size="lg", label=_('Search Inside')) }}
            </a>
            <h3 class="fulltext-suggestions__title">
                <a data-ol-link-track="SearchInsideSuggestion|SeeAllClick"
                   href="/search/inside?{{ urlencode(dict(q=query)) }}">
                    {{ _("Search Inside") }}
                </a>
                {{ _("—") }}
                {{ _('%(book_count)s books found with matching passages', book_count=num_found) }}
            </h3>
        </div>

        {% for doc in hits %}
            {% if doc.get('edition') %}
                {{ item.render(
                doc['edition'],
                snippet=snippet.render(query, doc)
                ) }}
            {% endif %}
        {% endfor %}

        <h3 class="fulltext-suggestions__footer">
            <a class="fulltext-suggestions__footer-link"
               data-ol-link-track="SearchInsideSuggestion|SeeAllClick"
               href="/search/inside?{{ urlencode(dict(q=query)) }}">
                {{ _('See all %(results_count)s Search Inside Matches', results_count=num_found) }}
                <span class="fulltext-suggestions__right-chevron">
                    {# Decorative: the link text already says where it goes. #}
                    {{ icon("chevron-right", size="sm") }}
                </span>
            </a>
        </h3>
    </div>
{% endif %}
