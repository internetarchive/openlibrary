{#- Shared pieces of the /tasks pages. Data arrives precomputed from
    openlibrary/plugins/openlibrary/contribute.py; nothing here calls functions on it. -#}
{% macro book_header(book, compact=False, href=None, track=None) %}
    {#- ``href`` is where the cover and title lead: the book page by default, or a task on the dashboard,
        where people click the title expecting to start one. When it isn't the book page, view/edit
        buttons in the corner reach the book instead. ``track`` is the title link's "Category|Action|Label". -#}
    {% set href = href or book.key %}
    {% set cover %}
        {% if book.cover_url %}
            <img class="contrib-book__cover"
                 src="{{ book.cover_url }}"
                 alt=""
                 width="60"
                 height="90"
                 loading="lazy" />
        {% else %}
            <div class="contrib-book__cover contrib-book__cover--empty"
                 aria-hidden="true">{{ icon("book-open", size="md") }}</div>
        {% endif %}
    {% endset %}
    <div class="contrib-book{% if compact %} contrib-book--compact{% endif %}">
        {#- A second way to the title's link, so keep it out of the tab order and the accessibility tree. -#}
        <a class="contrib-cover-link"
           href="{{ href }}"
           tabindex="-1"
           aria-hidden="true">{{ cover }}</a>
        <div class="contrib-book__meta">
            <div class="contrib-book__title">
                <a href="{{ href }}"
                   {% if track %} data-ol-link-track="{{ track }}"{% endif %}>{{ book.title }}</a>
            </div>
            {% if book.authors %}<div class="contrib-book__authors">{{ book.authors }}</div>{% endif %}
            <div class="contrib-book__line">
                {% if book.edition_line %}<span>{{ book.edition_line }}</span>{% endif %}
                {% if book.isbn13 %}<span>ISBN {{ book.isbn13 }}</span>{% endif %}
                {% if book.edition_count and book.edition_count > 1 %}
                    <span>{{ _("one of %(count)s editions of this work", count=book.edition_count) }}</span>
                {% endif %}
            </div>
            {% if book.readers and not compact %}
                <div class="contrib-book__why">{{ _("Why this book: on about %(count)s readers' shelves.", count="{:,}".format(book.readers)) }}</div>
            {% endif %}
        </div>
        {% if href != book.key %}
            <div class="contrib-book__actions">
                <ol-tooltip content="{{ _('Go to book page') }}">
                    <ol-button variant="ghost" shape="icon" size="small" href="{{ book.key }}" aria-label="{{ _('Go to book page') }}">
                        {{ icon("eye", size="sm") }}
                    </ol-button>
                </ol-tooltip>
                <ol-tooltip content="{{ _('Go to edit page') }}">
                    <ol-button variant="ghost" shape="icon" size="small" href="{{ book.edit_url }}" aria-label="{{ _('Go to edit page') }}">
                        {{ icon("pencil", size="sm") }}
                    </ol-button>
                </ol-tooltip>
            </div>
        {% endif %}
    </div>
{% endmacro %}
{% macro task_row(task, track) %}
    {#- One to-do per field, styled as a menu item: an icon and the action it leads to.
        ``track`` is the analytics "Category|Action"; the field becomes the label. -#}
    <li class="contrib-row__task" data-task-key="{{ task.key }}">
        <a href="{{ task.url }}"
           data-ol-link-track="{{ track }}|{{ task.field }}">
            <span class="contrib-row__badge">{{ icon("plus", size="sm") }}</span>
            <span>{{ task.action_label }}</span>
        </a>
    </li>
{% endmacro %}
{% macro how_to(field_guide, links) %}
    <section class="contrib-help">
        <h2 class="contrib-h">{{ _("How to answer") }}</h2>
        <ol class="contrib-steps">
            <li>
                <div class="contrib-steps__text">
                    {% for para in field_guide.how.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
                </div>
                {% if links %}
                    <ul class="contrib-linkouts">
                        {% for link in links %}
                            <li>
                                <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}{{ icon("external-link", size="sm") }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% elif field_guide.sources %}
                    <p class="contrib-muted">{{ _("This edition has no ISBN to search by, so look it up by title and author.") }}</p>
                {% endif %}
            </li>
            {% for note in field_guide.notes %}
                <li>
                    <p>
                        {{ note.text }}
                        {% if note.href %}<a href="{{ note.href }}" target="_blank" rel="noopener noreferrer">{{ _("Guideline") }}</a>{% endif %}
                    </p>
                </li>
            {% endfor %}
        </ol>
    </section>
{% endmacro %}
{% macro traps(items) %}
    <section class="contrib-help">
        <h2 class="contrib-h">{{ _("How this edit goes wrong") }}</h2>
        <ul class="contrib-traps">
            {% for trap in items %}
                <li class="contrib-trap">
                    {{ icon("triangle-alert", size="sm") }}
                    <span>{{ trap }}</span>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endmacro %}
{% macro quick_tip() %}
    {#- The shortcuts a quick_next field offers: both end in "Save and next", so the buttons stay for anyone who prefers them. -#}
    <section class="contrib-help contrib-tip">
        <h2 class="contrib-h">{{ _("Tip") }}</h2>
        <p class="contrib-tip__text">{{ _("Press Enter, or click your answer a second time, to save and go straight to the next book.") }}</p>
    </section>
{% endmacro %}
{% macro evidence(blurb) %}
    {#- For a judgment, the record's own description is a clue; with none, the how-to's lookups stand in. -#}
    {% if blurb %}
        <section class="contrib-help">
            <h2 class="contrib-h">{{ _("What the record says") }}</h2>
            <p class="contrib-evidence">{{ blurb }}</p>
        </section>
    {% endif %}
{% endmacro %}
{% macro sibling_tally(tally, siblings, total, hint) %}
    {#- What the work's other editions put in this field: a count per value, then each edition behind a disclosure. -#}
    <section class="contrib-help">
        <h2 class="contrib-h">{{ ngettext("The other edition", "The other %(count)d editions", total, count=total) }}</h2>
        {% if hint %}<p>{{ hint }}</p>{% endif %}
        <ul class="contrib-tally">
            {% for t in tally["values"] %}
                <li>
                    <span class="contrib-tally__label">{{ t.label }}</span>
                    <span class="contrib-tally__bar"
                          style="--contrib-share: {{ t.share }}%"
                          aria-hidden="true"></span>
                    <span class="contrib-tally__count">{{ t.count }}</span>
                </li>
            {% endfor %}
            {% if tally.more %}
                <li class="contrib-muted">{{ ngettext("1 other value", "%(count)d other values", tally.more, count=tally.more) }}</li>
            {% endif %}
            {% if tally.unfilled %}
                <li class="contrib-muted">
                    <span class="contrib-tally__label">{{ _("Not filled in") }}</span>
                    <span class="contrib-tally__bar contrib-tally__bar--empty"
                          style="--contrib-share: {{ (100 * tally.unfilled / total) | round | int }}%"
                          aria-hidden="true"></span>
                    <span class="contrib-tally__count">{{ tally.unfilled }}</span>
                </li>
            {% endif %}
        </ul>
        <details class="contrib-disclosure">
            <summary>{{ _("See each edition") }}</summary>
            <ul class="contrib-siblings">
                {% for s in siblings %}
                    <li>
                        <span class="contrib-siblings__value{% if not s.value %} contrib-muted{% endif %}">{{ s.value or _("Not filled in") }}</span>
                        {% if s.about %}<a href="{{ s.url }}">{{ s.about }}</a>{% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if total > siblings|length %}
                <p class="contrib-muted">{{ _("And %(count)s more.", count=total - siblings|length) }}</p>
            {% endif %}
        </details>
    </section>
{% endmacro %}
{% macro answer_control(task, field_guide, is_identifier, value, languages, cover_suggestion=None, choices=[]) %}
    {% if choices %}
        {#- A few fixed answers with what each means, none picked in advance: a judgment the librarian makes, not a
            default they confirm. "Not sure" is one of the rows; the handler counts it the way it counts "I couldn't find it".
            With quick_next, the picked row shows a hint that a second click saves and moves on (contribute.js). -#}
        {% with name="value", rows=choices, labelled_by="contrib-other-label",
            again_hint=(_("Click again to save and continue") if field_guide.quick_next else "") %}
            {% include "forms/choice_list.html.jinja" %}
        {% endwith %}
    {% elif field_guide.input_type == "file" %}
        {#- The choices for the new cover, as rows. Each fills the one file input, so saving is the same for all of them.
            contribute.js reveals the Amazon row once its image loads, and previews the choice in the record's cover slot. -#}
        <fieldset class="contrib-cover-options">
            <legend class="contrib-visually-hidden">{{ _("Choose the new cover") }}</legend>
            {% if cover_suggestion %}
                <label class="contrib-cover-option"
                       data-cover-option="suggested"
                       data-cover-suggestion="{{ cover_suggestion.url }}"
                       hidden>
                    <input type="radio"
                           name="cover_choice"
                           value="suggested"
                           class="contrib-visually-hidden" />
                    <img class="contrib-cover-option__thumb"
                         data-cover-suggested-thumb
                         alt=""
                         width="160"
                         height="240" />
                    <span class="contrib-cover-option__text">
                        <span class="contrib-cover-option__title">{{ _("Cover from Amazon") }}</span>
                        <span class="contrib-cover-option__meta">{{ _("Found by ISBN %(isbn)s", isbn=cover_suggestion.isbn10) }}</span>
                    </span>
                </label>
            {% endif %}
            <div class="contrib-cover-option contrib-cover-option--upload"
                 data-cover-option="upload"
                 data-cover-drop>
                <label class="contrib-cover-option__pick">
                    <input type="radio"
                           name="cover_choice"
                           value="upload"
                           class="contrib-visually-hidden" />
                    <span class="contrib-cover-option__thumb contrib-cover-option__thumb--empty">
                        {{ icon("upload", size="lg") }}
                        <img data-cover-upload-thumb alt="" hidden />
                    </span>
                    <span class="contrib-cover-option__text">
                        <span class="contrib-cover-option__title">{{ _("Upload a new image") }}</span>
                        <span class="contrib-cover-option__meta" data-cover-upload-name>{{ _("Drop a file here, paste, or browse") }}</span>
                    </span>
                </label>
                <ol-button class="contrib-cover-option__browse" variant="secondary" size="small" type="button" data-cover-browse>
                    {{ _("Browse") }}
                </ol-button>
                <input id="contrib-other-value"
                       type="file"
                       name="file"
                       class="contrib-visually-hidden"
                       accept=".jpg, .jpeg, .gif, .png, .webp"
                       required
                       tabindex="-1"
                       data-cover-input />
            </div>
        </fieldset>
        <p class="contrib-muted contrib-field__hint">{{ _("JPG, GIF, PNG or WebP, up to 10 MB.") }}</p>
    {% elif is_identifier %}
        <input id="contrib-other-value"
               type="text"
               name="value"
               class="contrib-input contrib-input--id"
               placeholder="{{ field_guide.placeholder }}"
               inputmode="numeric"
               autocomplete="off"
               data-id-input
               data-id-field="{{ task.field }}"
               value="{{ value }}"
               data-msg-ok="{{ _('That looks like a valid number.') }}"
               data-msg-tidied="{{ _('Will be stored as %(value)s.', value='__VALUE__') }}"
               data-msg-url="{{ _('Paste only the number, not the web address.') }}"
               data-msg-bad="{{ _('That is not a valid number for this catalog.') }}" />
    {% elif languages %}
        <ol-options-popover id="contrib-other-value" class="contrib-picker" name="value" label="{{ _('Choose a language') }}" heading="{{ _('Languages') | upper }}" aria-label="{{ field_guide.label }}" placeholder="{{ _('Filter languages') }}" no-matches-label="{{ _('No matching language') }}" show-selection selected="{{ value }}" items='{{ languages | tojson }}'>
        </ol-options-popover>
    {% else %}
        <input id="contrib-other-value"
               type="{{ field_guide.input_type }}"
               name="value"
               class="contrib-input{% if field_guide.input_type == 'number' %} contrib-input--number{% endif %}"
               placeholder="{{ field_guide.placeholder }}"
               {% if field_guide.input_type == "number" %}min="1"{% endif %}
               value="{{ value }}"
               autocomplete="off" />
    {% endif %}
{% endmacro %}
{% macro record_form(data) %}
    {#- The edition's record with the missing field as the live input, so the answer has an obvious place.
        Identifiers are gated behind a confirm box: a wrong number silently corrupts record matching. -#}
    {% set task = data.task %}
    {% set book = data.book %}
    <form method="post"
          action="{{ task.url }}"
          class="contrib-answer"
          {% if data.is_cover %}enctype="multipart/form-data" data-cover-form{% endif %}
          data-task-form
          {% if data.is_identifier %}data-id-form{% endif %}
          {% if data.field_guide.quick_next %}data-quick-next{% endif %}
          data-task-key="{{ task.key }}"
          data-task-field="{{ task.field }}">
        {% if data.error %}<p class="ol-message ol-message--error" role="alert">{{ data.error }}</p>{% endif %}
        <div class="contrib-record">
            {#- A second way to the title's link, so keep it out of the tab order and the accessibility tree. -#}
            {% if data.is_cover %}
                {#- The slot the answer fills: a drop target that shows the chosen image. The file input is the accessible control. -#}
                <div class="contrib-record__cover contrib-cover-drop" data-cover-drop>
                    <span class="contrib-cover-drop__empty" aria-hidden="true">{{ icon("image", size="lg") }}</span>
                    <img class="contrib-cover-drop__preview" data-cover-preview alt="" hidden />
                </div>
            {% else %}
                <a class="contrib-cover-link"
                   href="{{ book.key }}"
                   tabindex="-1"
                   aria-hidden="true">
                    {% if book.cover_url %}
                        <img class="contrib-record__cover"
                             src="{{ book.cover_url }}"
                             alt=""
                             width="96"
                             height="144"
                             loading="lazy" />
                    {% else %}
                        <div class="contrib-record__cover contrib-book__cover--empty"
                             aria-hidden="true">{{ icon("book-open", size="md") }}</div>
                    {% endif %}
                </a>
            {% endif %}
            <div class="contrib-record__head">
                <div class="contrib-book__title">
                    <a href="{{ book.key }}">{{ book.title }}</a>
                </div>
                {% if book.authors %}<div class="contrib-book__authors">{{ book.authors }}</div>{% endif %}
            </div>
            <ol-tooltip class="contrib-record__edit" content="{{ _('Go to edit page') }}">
                <ol-button variant="ghost" shape="icon" size="small" href="{{ book.edit_url }}" aria-label="{{ _('Go to edit page') }}">
                    {{ icon("pencil", size="sm") }}
                </ol-button>
            </ol-tooltip>
            <dl class="contrib-record__fields">
                {% for row in data.record_fields %}
                    {% if row.ask %}
                        <div class="contrib-record__row contrib-record__row--ask">
                            <dt>
                                {#- A choice list is a group of radios, so its label names the group rather than one control. -#}
                                {% if data.choices %}
                                    <span class="contrib-record__ask-label" id="contrib-other-label">{{ row.label }}</span>
                                {% else %}
                                    <label for="contrib-other-value">{{ row.label }}</label>
                                {% endif %}
                            </dt>
                            <dd>
                                {{ answer_control(task, data.field_guide, data.is_identifier, data.value, data.languages, data.cover_suggestion, data.choices) }}
                                {% if data.is_identifier %}<p class="contrib-field__verdict" data-id-verdict role="status"></p>{% endif %}
                                {% if data.suggestions %}
                                    <div class="contrib-suggest" data-suggest>
                                        <span>{{ _("Other editions say") }}</span>
                                        {% for s in data.suggestions %}
                                            <ol-chip size="small" count="{{ s.count }}" data-value="{{ s.value }}" accessible-label="{{ ngettext('%(value)s, on 1 edition', '%(value)s, on %(count)d editions', s.count, value=s.label, count=s.count) }}">
                                                {{ s.label }}
                                            </ol-chip>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if data.field_guide.check %}<p class="contrib-field__hint">{{ data.field_guide.check }}</p>{% endif %}
                                {% if data.field_guide.confirm %}
                                    <label class="contrib-confirm">
                                        <input type="checkbox" name="confirmed" value="1" required />
                                        <span>{{ data.field_guide.confirm }}</span>
                                    </label>
                                {% endif %}
                            </dd>
                        </div>
                    {% else %}
                        <div class="contrib-record__row">
                            <dt>{{ row.label }}</dt>
                            <dd>
                                {{ row.value }}
                            </dd>
                        </div>
                    {% endif %}
                {% endfor %}
            </dl>
        </div>
        {#- A cover's history comment is the image itself, so there is no comment to add. -#}
        {% if not data.is_cover %}
            <details class="contrib-disclosure"{% if data.note %} open{% endif %}>
                <summary>{{ _("Add a comment about your edit") }}</summary>
                <label class="contrib-visually-hidden" for="contrib-note">{{ _("Edit comment") }}</label>
                <textarea id="contrib-note"
                          name="note"
                          rows="2"
                          class="contrib-input"
                          placeholder="{{ _('Where you found it') }}">{{ data.note }}</textarea>
            </details>
        {% endif %}
        <div class="contrib-answer__actions">
            <div class="contrib-answer__save">
                {#- First in the form, so Enter in the answer field saves and moves on. -#}
                <ol-button variant="primary" type="submit" name="then" value="next">
                    {{ _("Save and next") }}
                </ol-button>
                <ol-button variant="secondary" type="submit" name="then" value="done">
                    {{ _("Save") }}
                </ol-button>
            </div>
            <div class="contrib-answer__move">
                {#- Submits without the answer's checks: the handler notes it and moves on to the next task.
                    A choice list carries "Not sure" as one of its rows instead. -#}
                {% if not data.choices %}
                    <ol-button variant="ghost" type="submit" name="then" value="notfound" formnovalidate data-skip data-ol-link-track="TaskForm|NotFound|{{ task.field }}">
                        {{ _("I couldn't find it") }}
                    </ol-button>
                {% endif %}
                <ol-button variant="ghost" href="{{ data.skip_url }}" data-skip data-ol-link-track="TaskForm|Skip|{{ task.field }}">
                    {{ _("Skip") }}
                    {{ icon("arrow-right", slot="icon-end") }}
                </ol-button>
            </div>
        </div>
    </form>
{% endmacro %}
{% macro feed_row(row) %}
    {#- One recent edit on the public /tasks page. contribute.js builds the same markup for rows that arrive later. -#}
    <li class="contrib-feed__row" data-feed-row>
        <div class="contrib-feed__inner">
            <time class="contrib-feed__when"
                  datetime="{{ row.timestamp }}"
                  data-feed-when>{{ row.when }}</time>
            <a class="contrib-feed__cover"
               href="{{ row.key }}"
               tabindex="-1"
               aria-hidden="true">
                {% if row.cover_url %}
                    <img src="{{ row.cover_url }}"
                         alt=""
                         width="32"
                         height="48"
                         loading="lazy" />
                {% else %}
                    <span class="contrib-feed__cover--empty">{{ icon("book-open", size="sm") }}</span>
                {% endif %}
            </a>
            <div class="contrib-feed__meta">
                <div class="contrib-feed__title">
                    <a class="contrib-feed__link" href="{{ row.key }}">{{ row.title }}</a>
                    {% if row.authors %}<span class="contrib-feed__by">{{ _("by %(authors)s", authors=row.authors) }}</span>{% endif %}
                </div>
                <div class="contrib-feed__line">
                    <span class="contrib-feed__editor">{{ row.editor }}</span>
                    <span>{{ row.comment or row.action }}</span>
                </div>
            </div>
        </div>
    </li>
{% endmacro %}
{% macro feed_skeleton_row() %}
    {#- A row's shape while a cold cache builds the feed in the background; contribute-feed.js swaps each one for a real row. -#}
    <li class="contrib-feed__row contrib-feed__row--skeleton"
        data-feed-skeleton
        aria-hidden="true">
        <div class="contrib-feed__inner">
            <span class="skeleton contrib-feed__when"></span>
            <span class="skeleton contrib-feed__cover-skeleton"></span>
            <div class="contrib-feed__meta">
                <span class="skeleton contrib-feed__title"></span>
                <span class="skeleton contrib-feed__line"></span>
            </div>
        </div>
    </li>
{% endmacro %}
{% macro row_skeleton(tasks=2) %}
    {#- A dashboard card's shape while a cold cache builds the list in the background; contribute.js swaps them for the rows. -#}
    <li class="contrib-row contrib-row--skeleton"
        data-row-skeleton
        aria-hidden="true">
        <div class="contrib-book contrib-book--compact">
            <span class="skeleton contrib-row__cover-skeleton"></span>
            <div class="contrib-book__meta">
                <span class="skeleton contrib-book__title"></span>
                <span class="skeleton contrib-book__authors"></span>
                <span class="skeleton contrib-book__line"></span>
            </div>
        </div>
        <ul class="contrib-row__tasks">
            {% for _i in range(tasks) %}
                <li class="contrib-row__task">
                    <span class="skeleton"></span>
                </li>
            {% endfor %}
        </ul>
    </li>
{% endmacro %}
