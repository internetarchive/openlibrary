{#- Shared pieces of the First Edits pages. Data arrives precomputed from
    openlibrary/plugins/openlibrary/contribute.py; nothing here calls functions on it. -#}
{% macro book_header(book, compact=False) %}
    <div class="fe-book{% if compact %} fe-book--compact{% endif %}">
        {% if book.cover_url %}
            <img class="fe-book__cover"
                 src="{{ book.cover_url }}"
                 alt=""
                 width="60"
                 height="90"
                 loading="lazy" />
        {% else %}
            <div class="fe-book__cover fe-book__cover--empty" aria-hidden="true">{{ icon("book-open", size="md") }}</div>
        {% endif %}
        <div class="fe-book__meta">
            <div class="fe-book__title">
                {% if book.key %}<a href="{{ book.key }}">{{ book.title }}</a>{% else %}{{ book.title }}{% endif %}
            </div>
            {% if book.authors %}<div class="fe-book__authors">{{ book.authors }}</div>{% endif %}
            <div class="fe-book__line">
                {% if book.edition_line %}<span>{{ book.edition_line }}</span>{% endif %}
                {% if book.isbn13 %}<span>ISBN {{ book.isbn13 }}</span>{% endif %}
                {% if book.edition_count and book.edition_count > 1 %}
                    <span>{{ _("one of %(count)s editions of this work", count=book.edition_count) }}</span>
                {% endif %}
            </div>
            {% if book.readers and not compact %}
                <div class="fe-book__why">{{ _("Why this book: on about %(count)s readers' shelves.", count="{:,}".format(book.readers)) }}</div>
            {% endif %}
        </div>
    </div>
{% endmacro %}
{% macro task_row(task) %}
    {#- One to-do per field, styled as a menu item: an icon and the action it leads to. -#}
    <li class="fe-row__task"
        data-task-key="{{ task.key }}"
        {% if task.weight is defined %}data-weight="{{ task.weight }}"{% endif %}
        {% if task.question %}data-question="{{ task.question }}"{% endif %}>
        <a href="{{ task.url }}">
            <span class="fe-row__badge">{{ icon("plus", size="sm") }}</span>
            <span>{{ task.action_label }}</span>
        </a>
    </li>
{% endmacro %}
{% macro sibling_list(siblings, total) %}
    <div class="fe-siblings">
        {% if total %}
            <h2 class="fe-subhead">{{ _("How the other %(count)s editions of this work fill this in", count=total) }}</h2>
        {% else %}
            <h2 class="fe-subhead">{{ _("Other editions of this work") }}</h2>
        {% endif %}
        {% if siblings %}
            <ul class="fe-siblings__list">
                {% for s in siblings %}
                    <li>
                        {% if s.value %}
                            {{ s.value }}
                        {% else %}
                            <span class="fe-muted">{{ _("Not filled in") }}</span>
                        {% endif %}
                        {% if s.about %}
                            <span class="fe-muted">·</span> <a href="{{ s.url }}">{{ s.about }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
            {% if total > siblings|length %}
                <p class="fe-muted">{{ _("And %(count)s more.", count=total - siblings|length) }}</p>
            {% endif %}
        {% else %}
            <p class="fe-muted">{{ _("This is the only edition of this work catalogued so far, so there is nothing to compare against yet.") }}</p>
        {% endif %}
    </div>
{% endmacro %}
{% macro how_to(playbook, links) %}
    <div class="fe-linkouts">
        <h2 class="fe-subhead">{{ _("Where to find it") }}</h2>
        <p>{{ playbook.how }}</p>
        {% if links %}
            <ul class="fe-linkouts__list">
                {% for link in links %}
                    <li>
                        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="fe-muted">{{ _("This edition has no ISBN to search by, so look it up by title and author.") }}</p>
        {% endif %}
        {% for note in playbook.notes %}
            <p class="fe-note">
                {{ note.text }}
                {% if note.href %}<a href="{{ note.href }}" target="_blank" rel="noopener noreferrer">{{ _("Guideline") }}</a>{% endif %}
            </p>
        {% endfor %}
    </div>
{% endmacro %}
{% macro traps(items) %}
    <div class="fe-traps">
        <h2 class="fe-subhead">{{ _("How this edit goes wrong") }}</h2>
        <ul class="fe-traps__list">
            {% for trap in items %}
                <li class="fe-trap">
                    {{ icon("triangle-alert", size="sm") }}
                    <span>{{ trap }}</span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endmacro %}
{% macro answer_form(task, playbook, is_identifier, wait_days, list_url) %}
    {#- One shape for every field. An identifier answer is gated behind "I opened the record":
        a wrong number silently corrupts record matching. -#}
    <form method="post"
          action="{{ task.url }}"
          class="fe-answer"
          data-task-form
          {% if is_identifier %}data-id-form{% endif %}
          data-task-key="{{ task.key }}">
        <fieldset class="fe-answer__options">
            <legend class="fe-label">{{ _("Your answer") }}</legend>
            <label class="fe-choice">
                <input type="radio"
                       name="choice"
                       value="other"
                       {% if is_identifier %}data-gated{% endif %}
                       checked />
                <span class="fe-choice__body"><strong>{{ _("I found it") }}</strong></span>
            </label>
            <div class="fe-other" data-other-input hidden>
                <label class="fe-label" for="fe-other-value">{{ playbook.answer_label }}</label>
                {% if is_identifier %}
                    <input id="fe-other-value"
                           type="text"
                           name="value"
                           class="fe-input"
                           placeholder="{{ playbook.placeholder }}"
                           inputmode="numeric"
                           autocomplete="off"
                           data-id-input
                           data-id-field="{{ task.field }}"
                           data-msg-ok="{{ _('That looks like a valid number.') }}"
                           data-msg-tidied="{{ _('Will be stored as %(value)s.', value='__VALUE__') }}"
                           data-msg-url="{{ _('Paste only the number, not the web address.') }}"
                           data-msg-bad="{{ _('That is not a valid number for this catalog.') }}" />
                    <p class="fe-other__verdict" data-id-verdict role="status"></p>
                {% else %}
                    <input id="fe-other-value"
                           type="{{ playbook.input_type }}"
                           name="value"
                           class="fe-input"
                           placeholder="{{ playbook.placeholder }}"
                           {% if playbook.input_type == "number" %}min="1"{% endif %}
                           autocomplete="off" />
                {% endif %}
            </div>
            <label class="fe-choice fe-choice--unsure">
                <input type="radio" name="choice" value="unsure" />
                <span class="fe-choice__body">
                    <strong>{{ _("I couldn't find it") }}</strong>
                    <span class="fe-muted">{{ _("Sends it to a librarian with a note. Never counts against you.") }}</span>
                </span>
            </label>
        </fieldset>
        {% if is_identifier %}
            <label class="fe-confirm" data-id-confirm>
                <input type="checkbox" name="confirmed" value="1" required />
                <span>{{ _("I opened the record and the year and publisher match this edition.") }}</span>
            </label>
        {% endif %}
        <label class="fe-answer__note">
            <span class="fe-label">{{ _("Note for the reviewer (optional)") }}</span>
            <textarea name="note"
                      rows="2"
                      class="fe-input"
                      placeholder="{{ _('Where you found it') }}"></textarea>
        </label>
        <div class="fe-answer__actions">
            <ol-button variant="primary" type="submit">
                {{ _("Send to a librarian") }}
            </ol-button>
            <ol-button variant="ghost" href="{{ list_url }}" data-skip>
                {{ _("Skip this book") }}
            </ol-button>
            <span class="fe-muted fe-answer__promise">{{ _("Goes into the review queue. Usually looked at within %(days)s days.", days=wait_days) }}</span>
        </div>
    </form>
{% endmacro %}
