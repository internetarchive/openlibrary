{# Takes `url` and `attrs`, a dict of extra iframe attributes. Only archive.org URLs are embedded. #}
{% macro iframe(url, attrs={}) %}
    {% if url.startswith("http://www.archive.org/") or url.startswith("http://archive.org/") or url.startswith("//archive.org/") %}
        {# Wiki editors write `attrs`: xmlattr escapes the values and rejects unsafe names. #}
        <iframe src="{{ url }}"{{ attrs | xmlattr }}></iframe>
    {% endif %}
{% endmacro %}
{#- Rendering this file directly (from the Templetor macro) draws the iframe; importing it doesn't. -#}
{%- if url is defined %}
    {{ iframe(url, attrs | default({})) }}
{%- endif %}
