{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2021": true
  },
  "ignorePatterns": [
    "**/*.vue",
    "config/",
    "docker/",
    "docs/wiki/",
    "infogami/",
    "openlibrary/components/lit/icons.generated.js",
    "static/build/",
    "provisioning/",
    "vendor/",
    "tests/screenshots/"
  ],
  "rules": {
    "prefer-template": "error",
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-console": "error",
    "no-redeclare": "error",
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "caughtErrors": "none"
      }
    ],
    "no-useless-escape": "error",
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "webpackChunkName"
        ],
        "location": "anywhere"
      }
    ],
    "vars-on-top": "error",
    "prefer-const": "error",
    "no-unused-expressions": "off",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-unexpected-multiline": "error",
    "unicorn/prefer-node-protocol": "error",
    "no-else-return": "error",
    "import/no-duplicates": "error",
    "unicorn/escape-case": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "no-var": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-set-has": "error",
    "array-callback-return": "error",
    "no-extend-native": "error",
    "no-lonely-if": "error",
    "no-sequences": "error",
    "no-shadow": "error",
    "no-unneeded-ternary": "error",
    "no-useless-return": "error",
    "radix": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-string-slice": "error",
    "vitest/valid-title": "error",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/no-conditional-tests": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/unit/**/*.js",
        "openlibrary/components/__tests__/**/*.js",
        "openlibrary/components/test-utils/**/*.js"
      ],
      "env": {
        "vitest": true,
        "node": true
      }
    },
    {
      "files": [
        "openlibrary/components/dev/serve-component.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "openlibrary/plugins/openlibrary/js/edit.js"
      ],
      "globals": {
        "render_author": "readonly",
        "render_author_autocomplete_item": "readonly",
        "render_series": "readonly",
        "render_series_autocomplete_item": "readonly",
        "render_subject_autocomplete_item": "readonly",
        "render_seed_field": "readonly",
        "render_language_field": "readonly",
        "render_lazy_work_preview": "readonly",
        "render_language_autocomplete_item": "readonly",
        "render_work_field": "readonly",
        "render_work_autocomplete_item": "readonly"
      }
    },
    {
      "files": [
        "**/*.mjs",
        "**/*.cjs",
        "**/*.config.js",
        "**/*.config.ts",
        "tests/e2e/**/*.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/*.config.ts"
      ],
      "rules": {
        "no-warning-comments": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.mjs",
        "tests/e2e/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
