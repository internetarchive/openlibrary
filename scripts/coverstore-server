#!/usr/bin/env python
"""Run coverstore server.

Usage:

start coverstore using uvicorn (development, with autoreload):

    ./scripts/coverstore-server coverstore.yml --uvicorn --reload --port 7075

start coverstore using gunicorn with uvicorn workers (production):

    ./scripts/coverstore-server coverstore.yml --gunicorn -b 0.0.0.0:7075

run the archiver instead of serving:

    ./scripts/coverstore-server coverstore.yml --archive

"""

import os
import sys

import _init_path  # noqa: F401  Imported for its side effect of setting PYTHONPATH


def setup_env():
    # make sure PYTHON_EGG_CACHE is writable
    os.environ["PYTHON_EGG_CACHE"] = "/tmp/.python-eggs"


def start_uvicorn_server(configfile: str) -> None:
    import uvicorn

    os.environ["COVERSTORE_CONFIG"] = configfile
    # --factory keeps the reloader parent light (https://uvicorn.dev/#application-factories)
    sys.argv = [sys.argv[0], "--factory", *sys.argv[1:], "openlibrary.coverstore.asgi_app:create_app"]
    uvicorn.main()


def start_gunicorn_server(configfile: str) -> None:
    """Starts the coverstore server using gunicorn with uvicorn workers."""
    from gunicorn.app.base import Application

    class ASGIServer(Application):
        def init(self, parser, opts, args):
            return {"worker_class": "uvicorn.workers.UvicornWorker"}

        def load(self):
            from openlibrary.coverstore.asgi_app import create_app

            return create_app(configfile)

    ASGIServer("%prog coverstore.yml --gunicorn [options]").run()


def run_archiver(configfile: str) -> None:
    from openlibrary.coverstore import server

    server.main(configfile, "--archive")


if __name__ == "__main__":
    setup_env()
    config_file = sys.argv.pop(1)

    if "--archive" in sys.argv:
        run_archiver(config_file)
    elif "--gunicorn" in sys.argv:
        sys.argv.pop(sys.argv.index("--gunicorn"))
        start_gunicorn_server(config_file)
    else:
        if "--uvicorn" in sys.argv:
            sys.argv.pop(sys.argv.index("--uvicorn"))
        start_uvicorn_server(config_file)
